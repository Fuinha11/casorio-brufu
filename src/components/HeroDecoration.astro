---
interface Props {
  variant?: 'light' | 'dark';
}

const { variant = 'light' } = Astro.props;
const basePath = import.meta.env.BASE_URL || '';
---

<img src={`${basePath}/images/logo.svg`} alt="" class={`hero-deco hero-deco-left hero-deco-${variant}`} />
<img src={`${basePath}/images/logo.svg`} alt="" class={`hero-deco hero-deco-right hero-deco-${variant}`} />

<style>
  .hero-deco {
    position: absolute;
    width: auto;
    height: 200px;
    opacity: 0.1;
    pointer-events: none;
  }

  .hero-deco-left {
    top: 50%;
    left: 20px;
    transform: translateY(-50%);
    animation: floatLeft 8s ease-in-out infinite;
  }

  .hero-deco-right {
    top: 50%;
    right: 20px;
    transform: translateY(-50%);
    animation: floatRight 8s ease-in-out infinite 2s;
  }

  /* Light hero (cream background) - solid marsala */
  .hero-deco-light {
    filter: brightness(0) sepia(1) hue-rotate(320deg) saturate(5);
    opacity: 0.12;
  }

  /* Dark hero (primary color background) - white semi-transparent */
  .hero-deco-dark {
    filter: brightness(0) invert(1);
    opacity: 0.15;
  }

  @keyframes floatLeft {
    0%, 100% { transform: translateY(-50%) rotate(-5deg); }
    50% { transform: translateY(calc(-50% - 20px)) rotate(5deg); }
  }

  @keyframes floatRight {
    0%, 100% { transform: translateY(-50%) rotate(5deg); }
    50% { transform: translateY(calc(-50% - 15px)) rotate(-3deg); }
  }

  @media (max-width: 768px) {
    .hero-deco {
      height: 120px;
      opacity: 0.08;
    }

    .hero-deco-left {
      left: 10px;
    }

    .hero-deco-right {
      right: 10px;
    }
  }
</style>
