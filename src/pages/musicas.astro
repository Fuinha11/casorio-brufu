---
import ProtectedLayout from '@/layouts/ProtectedLayout.astro';
---

<ProtectedLayout title="Sugestão de Músicas">
  <section class="music-hero">
    <div class="music-hero-content">
      <span class="music-subtitle">Playlist</span>
      <h1 class="music-title">Sugestão de Músicas</h1>
    </div>
  </section>

  <section class="music-main">
    <div class="music-container">
      <div class="music-intro">
        <div class="music-icon">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
            <path d="M9 18V5l12-2v13M9 18c0 1.657-1.343 3-3 3s-3-1.343-3-3 1.343-3 3-3 3 1.343 3 3zM21 16c0 1.657-1.343 3-3 3s-3-1.343-3-3 1.343-3 3-3 3 1.343 3 3z"></path>
          </svg>
        </div>
        <h2 class="music-intro-title">Ajude a montar a playlist!</h2>
        <p class="music-intro-text">
          Queremos que a festa seja inesquecível! Sugira suas músicas favoritas
          e ajude a criar a trilha sonora perfeita para celebrar conosco.
        </p>
      </div>

      <form id="musicForm" class="music-form">
        <input type="hidden" id="guestCode" name="guestCode" />
        <input type="hidden" id="guestName" name="guestName" />

        <div class="music-card">
          <div class="music-row">
            <span class="music-row-label">Música</span>
            <div class="music-row-content">
              <input type="text" class="music-input" id="songName" name="songName" placeholder="Nome da música" required />
            </div>
          </div>

          <div class="music-row">
            <span class="music-row-label">Artista</span>
            <div class="music-row-content">
              <input type="text" class="music-input" id="artist" name="artist" placeholder="Nome do artista ou banda" required />
            </div>
          </div>

          <div class="music-row">
            <span class="music-row-label">Por que?</span>
            <div class="music-row-content">
              <textarea class="music-textarea" id="reason" name="reason" placeholder="Conta pra gente por que essa música é especial (opcional)" rows="3"></textarea>
            </div>
          </div>
        </div>

        <div id="formMessage" class="music-message"></div>

        <button type="submit" id="submitBtn" class="music-submit-btn">
          Enviar Sugestão
        </button>
      </form>

      <div id="suggestionsList" class="suggestions-list"></div>

      <div class="music-tips">
        <h3 class="music-tips-title">Dicas</h3>
        <ul class="music-tips-list">
          <li>Sugira músicas que façam você querer dançar!</li>
          <li>Pode ser qualquer gênero - quanto mais variedade, melhor!</li>
          <li>Você pode sugerir quantas músicas quiser</li>
        </ul>
      </div>
    </div>
  </section>
</ProtectedLayout>

<style is:global>
  .music-hero {
    padding: 6rem 1.5rem 4rem;
    background: linear-gradient(135deg, #FFFDF9 0%, #F5F0E8 100%);
    text-align: center;
  }
  .music-hero-content {
    max-width: 600px;
    margin: 0 auto;
  }
  .music-subtitle {
    display: block;
    font-size: 0.875rem;
    text-transform: uppercase;
    letter-spacing: 0.2em;
    color: #999;
    margin-bottom: 0.5rem;
  }
  .music-title {
    font-family: 'Great Vibes', cursive;
    font-size: 2.5rem;
    color: #7A6B5A;
    margin: 0;
  }

  .music-main {
    background: #F9F7F4;
    padding: 3rem 1.5rem;
    min-height: 60vh;
  }
  .music-container {
    max-width: 600px;
    margin: 0 auto;
  }

  .music-intro {
    text-align: center;
    margin-bottom: 2rem;
  }
  .music-icon {
    width: 80px;
    height: 80px;
    margin: 0 auto 1.5rem;
    display: flex;
    align-items: center;
    justify-content: center;
    background: #F5F0E8;
    border-radius: 50%;
  }
  .music-icon svg {
    width: 40px;
    height: 40px;
    color: #7A6B5A;
  }
  .music-intro-title {
    font-family: 'Cormorant Garamond', serif;
    font-size: 1.5rem;
    color: #333;
    margin: 0 0 0.75rem;
  }
  .music-intro-text {
    font-size: 1rem;
    color: #666;
    line-height: 1.6;
    max-width: 450px;
    margin: 0 auto;
  }

  .music-card {
    background: #fff;
    border-radius: 16px;
    padding: 0;
    margin-bottom: 1.5rem;
    box-shadow: 0 4px 20px rgba(0,0,0,0.08);
    overflow: hidden;
  }

  .music-row {
    display: flex;
    align-items: center;
    padding: 1rem 1.5rem;
    border-bottom: 1px solid #f0f0f0;
  }
  .music-row:last-child {
    border-bottom: none;
  }
  .music-row-label {
    width: 100px;
    flex-shrink: 0;
    font-size: 0.8rem;
    font-weight: 700;
    color: #666;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }
  .music-row-content {
    flex: 1;
    min-width: 0;
  }

  .music-input {
    width: 100%;
    padding: 0.6rem 0.875rem;
    font-size: 0.95rem;
    border: 2px solid #e8e8e8;
    border-radius: 8px;
    background: #fafafa;
    color: #333;
    font-family: inherit;
    box-sizing: border-box;
    transition: border-color 0.2s, background 0.2s;
  }
  .music-input:focus {
    outline: none;
    border-color: #7A6B5A;
    background: #fff;
  }
  .music-input[readonly] {
    background: #f0f0f0;
    color: #666;
    cursor: not-allowed;
  }

  .music-textarea {
    width: 100%;
    padding: 0.6rem 0.875rem;
    font-size: 0.95rem;
    border: 2px solid #e8e8e8;
    border-radius: 8px;
    background: #fafafa;
    color: #333;
    font-family: inherit;
    box-sizing: border-box;
    resize: vertical;
    min-height: 80px;
    transition: border-color 0.2s, background 0.2s;
  }
  .music-textarea:focus {
    outline: none;
    border-color: #7A6B5A;
    background: #fff;
  }

  .music-message {
    margin-bottom: 1rem;
    border-radius: 8px;
    text-align: center;
    font-weight: 500;
  }
  .music-message.success {
    padding: 1rem;
    background: rgba(76, 175, 80, 0.1);
    border: 1px solid #4caf50;
    color: #2e7d32;
  }
  .music-message.error {
    padding: 1rem;
    background: rgba(229, 115, 115, 0.1);
    border: 1px solid #e57373;
    color: #c62828;
  }

  .music-submit-btn {
    width: 100%;
    padding: 1rem 2rem;
    background: #7A6B5A;
    color: white;
    border: none;
    border-radius: 8px;
    font-size: 1rem;
    font-weight: 600;
    cursor: pointer;
    transition: background 0.2s;
  }
  .music-submit-btn:hover {
    background: #665a4a;
  }
  .music-submit-btn:disabled {
    opacity: 0.6;
    cursor: not-allowed;
  }

  /* Previous Suggestions */
  .suggestions-list {
    margin-top: 2rem;
  }
  .suggestions-title {
    font-family: 'Cormorant Garamond', serif;
    font-size: 1.25rem;
    color: #333;
    margin: 0 0 1rem;
    text-align: center;
  }
  .suggestion-item {
    background: #fff;
    border-radius: 12px;
    padding: 1rem 1.25rem;
    margin-bottom: 0.75rem;
    box-shadow: 0 2px 8px rgba(0,0,0,0.06);
    display: flex;
    align-items: center;
    gap: 1rem;
  }
  .suggestion-icon {
    width: 40px;
    height: 40px;
    background: #F5F0E8;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    font-size: 1.25rem;
  }
  .suggestion-info {
    flex: 1;
    min-width: 0;
  }
  .suggestion-song {
    font-weight: 600;
    color: #333;
    margin: 0 0 0.25rem;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .suggestion-artist {
    font-size: 0.875rem;
    color: #888;
    margin: 0;
  }

  .music-tips {
    background: #fff;
    border-radius: 12px;
    padding: 1.5rem;
    margin-top: 2rem;
  }
  .music-tips-title {
    font-family: 'Cormorant Garamond', serif;
    font-size: 1.1rem;
    color: #333;
    margin: 0 0 1rem;
  }
  .music-tips-list {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .music-tips-list li {
    position: relative;
    padding-left: 1.75rem;
    margin-bottom: 0.5rem;
    color: #666;
    font-size: 0.9rem;
  }
  .music-tips-list li:last-child {
    margin-bottom: 0;
  }
  .music-tips-list li::before {
    content: '🎵';
    position: absolute;
    left: 0;
    font-size: 0.85rem;
  }

  @media (max-width: 600px) {
    .music-row {
      flex-direction: column;
      align-items: flex-start;
      gap: 0.5rem;
      padding: 0.875rem 1.25rem;
    }
    .music-row-label {
      width: auto;
    }
    .music-row-content {
      width: 100%;
    }
  }
</style>

<script>
  import { getAuthState, getApiUrl } from '@/scripts/auth';

  interface Suggestion {
    song: string;
    artist: string;
  }

  const API_URL = getApiUrl();
  let mySuggestions: Suggestion[] = [];

  function init() {
    const { guestCode, guestName } = getAuthState();

    const codeInput = document.getElementById('guestCode') as HTMLInputElement;
    if (codeInput && guestCode) {
      codeInput.value = guestCode;
    }

    const nameInput = document.getElementById('guestName') as HTMLInputElement;
    if (nameInput && guestName) {
      nameInput.value = guestName;
    }

    document.getElementById('musicForm')?.addEventListener('submit', handleSubmit);
  }

  function renderSuggestions() {
    const container = document.getElementById('suggestionsList');
    if (!container || mySuggestions.length === 0) return;

    container.innerHTML = `
      <h3 class="suggestions-title">Suas sugestoes</h3>
      ${mySuggestions.map(s => `
        <div class="suggestion-item">
          <div class="suggestion-icon">🎵</div>
          <div class="suggestion-info">
            <p class="suggestion-song">${s.song}</p>
            <p class="suggestion-artist">${s.artist}</p>
          </div>
        </div>
      `).join('')}
    `;
  }

  async function handleSubmit(e: Event) {
    e.preventDefault();

    const form = e.target as HTMLFormElement;
    const submitBtn = document.getElementById('submitBtn') as HTMLButtonElement;
    const messageEl = document.getElementById('formMessage') as HTMLElement;

    const songInput = document.getElementById('songName') as HTMLInputElement;
    const artistInput = document.getElementById('artist') as HTMLInputElement;
    const reasonInput = document.getElementById('reason') as HTMLTextAreaElement;

    const song = songInput.value.trim();
    const artist = artistInput.value.trim();
    const reason = reasonInput.value.trim();

    if (!song || !artist) {
      messageEl.textContent = 'Preencha o nome da música e do artista.';
      messageEl.className = 'music-message error';
      return;
    }

    submitBtn.disabled = true;
    submitBtn.textContent = 'Enviando...';
    messageEl.textContent = '';
    messageEl.className = 'music-message';

    try {
      const { guestCode, guestName } = getAuthState();

      const res = await fetch(API_URL, {
        method: 'POST',
        headers: { 'Content-Type': 'text/plain' },
        body: JSON.stringify({
          action: 'submitMusic',
          guestCode,
          guestName,
          song,
          artist,
          why: reason
        })
      });

      const result = await res.json();

      if (result.success) {
        messageEl.textContent = 'Sugestão enviada com sucesso! Obrigado!';
        messageEl.className = 'music-message success';

        // Clear form
        songInput.value = '';
        artistInput.value = '';
        reasonInput.value = '';

        // Add to local list
        mySuggestions.unshift({ song, artist });
        renderSuggestions();
      } else {
        messageEl.textContent = 'Erro ao enviar. Tente novamente.';
        messageEl.className = 'music-message error';
      }
    } catch {
      messageEl.textContent = 'Erro de conexão. Tente novamente.';
      messageEl.className = 'music-message error';
    } finally {
      submitBtn.disabled = false;
      submitBtn.textContent = 'Enviar Sugestão';
    }
  }

  document.addEventListener('DOMContentLoaded', init);
  document.addEventListener('astro:page-load', init);
</script>
