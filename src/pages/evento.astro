---
import ProtectedLayout from '@/layouts/ProtectedLayout.astro';
import AddToCalendar from '@/components/AddToCalendar.astro';
import HeroDecoration from '@/components/HeroDecoration.astro';

const eventDetails = {
  title: 'Casamento Bruna & Marcos',
  description: 'Celebração do casamento de Bruna e Marcos no Botânico Quintal, São Paulo.',
  startDate: '2026-04-10T20:00:00',
  endDate: '2026-04-11T02:00:00',
  location: 'Botânico Quintal - Av. Imperatriz Leopoldina, 681, Alto de Pinheiros, São Paulo/SP',
};

const vanSchedule = [
  { van: 'Van 1', time: '18:30', location: 'São Caetano do Sul (Olímpico)' },
  { van: 'Van 2', time: '19:00', location: 'Moema' },
  { van: 'Van 3', time: '19:15', location: 'Osasco' },
];

const returnSchedule = [
  { time: '01:30', vans: 'Todas as vans' },
  { time: '04:00', vans: 'Todas as vans' },
];
---

<ProtectedLayout title="O Evento">
  <section class="page-hero">
    <HeroDecoration variant="light" />
    <div class="container text-center">
      <p class="section-subtitle">Informações</p>
      <h1 class="page-title">O Evento</h1>
    </div>
  </section>

  <section class="section event-section">
    <div class="container">
      <div class="event-grid">
        <!-- Date & Time Card -->
        <div class="event-card">
          <div class="event-card-icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
              <path d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"></path>
            </svg>
          </div>
          <h3 class="event-card-title">Data e Horário</h3>
          <p class="event-card-date script-font">10 de Abril de 2026</p>
          <p class="event-card-time">Sexta-feira, às 20h00</p>

          <AddToCalendar
            title={eventDetails.title}
            description={eventDetails.description}
            startDate={eventDetails.startDate}
            endDate={eventDetails.endDate}
            location={eventDetails.location}
          />
        </div>

        <!-- Location Card -->
        <div class="event-card">
          <div class="event-card-icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
              <path d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"></path>
              <path d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"></path>
            </svg>
          </div>
          <h3 class="event-card-title">Local</h3>
          <p class="event-card-venue script-font">Botânico Quintal</p>
          <p class="event-card-address">
            Av. Imperatriz Leopoldina, 681<br/>
            Alto de Pinheiros - São Paulo/SP
          </p>
          <a href="https://instagram.com/botanicoquintal" target="_blank" rel="noopener noreferrer" class="event-card-link">
            @botanicoquintal
          </a>
        </div>

        <!-- Dress Code Card -->
        <div class="event-card">
          <div class="event-card-icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
              <path d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"></path>
            </svg>
          </div>
          <h3 class="event-card-title">Dress Code</h3>
          <p class="event-card-dresscode">Traje Social Completo</p>
          <p class="event-card-dresscode-note">
            Evite cores muito claras.<br/>
            Não use branco ou fica da porta pra fora!
          </p>
        </div>
      </div>

      <!-- Schedule & Weather Section -->
      <div class="schedule-weather-grid">
        <!-- Schedule -->
        <div class="schedule-section">
          <h3 class="section-title-sm">Programação</h3>
          <div class="schedule-timeline">
            <div class="schedule-item">
              <span class="schedule-time">20:00</span>
              <span class="schedule-event">Recepção dos Convidados</span>
            </div>
            <div class="schedule-item">
              <span class="schedule-time">20:15</span>
              <span class="schedule-event">Cerimônia</span>
            </div>
            <div class="schedule-item">
              <span class="schedule-time">21:30</span>
              <span class="schedule-event">Coquetel</span>
            </div>
            <div class="schedule-item">
              <span class="schedule-time">22:30</span>
              <span class="schedule-event">Jantar</span>
            </div>
            <div class="schedule-item">
              <span class="schedule-time">00:00</span>
              <span class="schedule-event">Festa</span>
            </div>
          </div>
        </div>

        <!-- Weather -->
        <div class="weather-section">
          <h3 class="section-title-sm">Previsão do Tempo</h3>
          <div class="weather-card" id="weatherCard">
            <div class="weather-date">
              <span class="weather-day">10</span>
              <span class="weather-month">Abril 2026</span>
            </div>
            <div class="weather-info">
              <div class="weather-icon" id="weatherIcon">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                  <circle cx="12" cy="12" r="5"></circle>
                  <path d="M12 1v2M12 21v2M4.22 4.22l1.42 1.42M18.36 18.36l1.42 1.42M1 12h2M21 12h2M4.22 19.78l1.42-1.42M18.36 5.64l1.42-1.42"></path>
                </svg>
              </div>
              <div class="weather-temp">
                <span class="temp-value" id="weatherTemp">--</span>
                <span class="temp-unit">°C</span>
              </div>
              <div class="weather-details">
                <p class="weather-condition" id="weatherCondition">Carregando...</p>
                <p class="weather-note" id="weatherNote">
                  Buscando dados meteorológicos...
                </p>
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- Map Section -->
      <div class="map-section">
        <h3 class="section-title-sm">Como Chegar</h3>
        <div class="map-card">
          <div class="map-info">
            <p class="map-warning">
              <strong>Atenção:</strong> O local não possui estacionamento nem manobrista.
              Recomendamos fortemente que você utilize as vans disponibilizadas ou aplicativos de transporte.
            </p>
            <div class="map-actions">
              <a
                href="https://www.google.com/maps/dir/?api=1&destination=Av.+Imperatriz+Leopoldina,+681,+Alto+de+Pinheiros,+Sao+Paulo"
                target="_blank"
                rel="noopener noreferrer"
                class="btn btn-primary"
              >
                Google Maps
              </a>
              <a
                href="https://www.waze.com/ul?q=Botanico%20Quintal%20Av%20Imperatriz%20Leopoldina%20681%20Sao%20Paulo&navigate=yes"
                target="_blank"
                rel="noopener noreferrer"
                class="btn btn-secondary"
              >
                Waze
              </a>
            </div>
          </div>
          <div class="map-container">
            <iframe
              src="https://www.google.com/maps?q=Botanico+Quintal,+Av.+Imperatriz+Leopoldina,+681,+Alto+de+Pinheiros,+Sao+Paulo,+SP&output=embed"
              width="100%"
              height="100%"
              style="border:0;"
              allowfullscreen=""
              loading="lazy"
              referrerpolicy="no-referrer-when-downgrade"
              title="Mapa do local"
            ></iframe>
          </div>
        </div>
      </div>

      <!-- Van Schedule Section -->
      <div class="van-section">
        <h3 class="section-title-sm">Transporte (Vans)</h3>
        <p class="van-intro">
          Disponibilizaremos vans para levar e trazer os convidados.
          Confira os horários e pontos de encontro abaixo.
        </p>

        <div class="van-grid">
          <!-- Ida -->
          <div class="van-card">
            <div class="van-card-header">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                <path d="M13 17h8m0 0l-4-4m4 4l-4 4M3 7h8m0 0L7 3m4 4L7 11"></path>
              </svg>
              <h4>Ida para o Evento</h4>
            </div>
            <table class="van-table">
              <thead>
                <tr>
                  <th>Van</th>
                  <th>Horário</th>
                  <th>Local de Saída</th>
                </tr>
              </thead>
              <tbody>
                {vanSchedule.map((item) => (
                  <tr>
                    <td class="van-name">{item.van}</td>
                    <td class="van-time">{item.time}</td>
                    <td class="van-location">{item.location}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>

          <!-- Volta -->
          <div class="van-card">
            <div class="van-card-header">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                <path d="M11 17H3m0 0l4 4m-4-4l4-4M21 7h-8m0 0l4-4m-4 4l4 4"></path>
              </svg>
              <h4>Volta para Casa</h4>
            </div>
            <table class="van-table">
              <thead>
                <tr>
                  <th>Horário</th>
                  <th>Vans</th>
                </tr>
              </thead>
              <tbody>
                {returnSchedule.map((item) => (
                  <tr>
                    <td class="van-time">{item.time}</td>
                    <td>{item.vans}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        </div>

        <p class="van-note">
          * Os horários de volta podem sofrer alterações de acordo com o andamento da festa.
        </p>
      </div>

      <!-- Transport Alternatives -->
      <div class="transport-alternatives">
        <h3 class="section-title-sm">Outras Opções de Transporte</h3>
        <div class="alternatives-grid">
          <div class="alternative-card">
            <div class="alternative-icon">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                <circle cx="12" cy="12" r="10"></circle>
                <line x1="4.93" y1="4.93" x2="19.07" y2="19.07"></line>
              </svg>
            </div>
            <h4>Sem Estacionamento</h4>
            <p>O local não possui estacionamento nem manobrista. Por favor, utilize as vans ou apps de transporte.</p>
          </div>

          <div class="alternative-card">
            <div class="alternative-icon">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                <path d="M16 4h2a2 2 0 012 2v14a2 2 0 01-2 2H6a2 2 0 01-2-2V6a2 2 0 012-2h2"></path>
                <rect x="8" y="2" width="8" height="4" rx="1" ry="1"></rect>
                <path d="M9 14l2 2 4-4"></path>
              </svg>
            </div>
            <h4>Uber / 99</h4>
            <p>Aplicativos de transporte são uma ótima opção. Lembre-se de considerar o preço dinâmico!</p>
          </div>
        </div>
      </div>
    </div>
  </section>
</ProtectedLayout>

<style>
  .page-hero {
    position: relative;
    overflow: hidden;
    padding: var(--spacing-24) var(--spacing-6) var(--spacing-16);
    background: linear-gradient(135deg, var(--color-secondary-light) 0%, var(--color-secondary) 100%);
  }

  .page-title {
    font-family: var(--font-script);
    font-size: var(--font-size-4xl);
    color: var(--color-primary);
    margin-bottom: 0;
  }

  .event-section {
    background-color: var(--color-background);
  }

  .event-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: var(--spacing-6);
    margin-bottom: var(--spacing-16);
  }

  .event-card {
    background-color: var(--color-background);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-xl);
    padding: var(--spacing-8);
    text-align: center;
    transition: all var(--transition-normal);
  }

  .event-card:hover {
    border-color: var(--color-primary-light);
    box-shadow: var(--shadow-lg);
  }

  .event-card-icon {
    width: 60px;
    height: 60px;
    margin: 0 auto var(--spacing-4);
    display: flex;
    align-items: center;
    justify-content: center;
    background-color: var(--color-secondary);
    border-radius: var(--radius-full);
  }

  .event-card-icon svg {
    width: 28px;
    height: 28px;
    color: var(--color-primary);
  }

  .event-card-title {
    font-family: var(--font-heading);
    font-size: var(--font-size-lg);
    color: var(--color-text);
    margin-bottom: var(--spacing-4);
  }

  .event-card-date {
    font-family: var(--font-script);
    font-size: var(--font-size-2xl);
    color: var(--color-primary);
    margin-bottom: var(--spacing-2);
  }

  .event-card-time {
    font-size: var(--font-size-md);
    color: var(--color-text-light);
    margin-bottom: 0;
  }

  .event-card-venue {
    font-family: var(--font-script);
    font-size: var(--font-size-2xl);
    color: var(--color-primary);
    margin-bottom: var(--spacing-2);
  }

  .event-card-address {
    font-size: var(--font-size-base);
    color: var(--color-text-light);
    line-height: var(--line-height-relaxed);
    margin-bottom: var(--spacing-2);
  }

  .event-card-link {
    font-size: var(--font-size-sm);
    color: var(--color-accent);
  }

  .event-card-dresscode {
    font-family: var(--font-heading);
    font-size: var(--font-size-xl);
    color: var(--color-primary);
    margin-bottom: var(--spacing-3);
  }

  .event-card-dresscode-note {
    font-size: var(--font-size-sm);
    color: var(--color-text-light);
    line-height: var(--line-height-relaxed);
    margin-bottom: 0;
  }

  /* Section Title */
  .section-title-sm {
    font-family: var(--font-heading);
    font-size: var(--font-size-2xl);
    color: var(--color-text);
    text-align: center;
    margin-bottom: var(--spacing-6);
  }

  /* Schedule & Weather Grid */
  .schedule-weather-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--spacing-8);
    margin-bottom: var(--spacing-16);
  }

  /* Schedule Section */
  .schedule-section {
    display: flex;
    flex-direction: column;
  }

  .schedule-timeline {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-4);
  }

  .schedule-item {
    display: flex;
    align-items: center;
    gap: var(--spacing-6);
    padding: var(--spacing-4) var(--spacing-6);
    background-color: var(--color-secondary);
    border-radius: var(--radius-lg);
  }

  .schedule-time {
    font-family: var(--font-heading);
    font-size: var(--font-size-lg);
    font-weight: var(--font-weight-semibold);
    color: var(--color-primary);
    min-width: 60px;
  }

  .schedule-event {
    font-size: var(--font-size-md);
    color: var(--color-text);
  }

  /* Weather Section */
  .weather-section {
    display: flex;
    flex-direction: column;
  }

  .weather-card {
    display: flex;
    align-items: center;
    gap: var(--spacing-6);
    background: linear-gradient(135deg, var(--color-primary-light) 0%, var(--color-primary) 100%);
    border-radius: var(--radius-xl);
    padding: var(--spacing-6);
    color: var(--color-text-inverse);
    flex: 1;
  }

  .weather-date {
    text-align: center;
    padding-right: var(--spacing-6);
    border-right: 1px solid var(--color-white-alpha-20);
  }

  .weather-day {
    display: block;
    font-family: var(--font-heading);
    font-size: var(--font-size-3xl);
    font-weight: var(--font-weight-bold);
    line-height: 1;
  }

  .weather-month {
    display: block;
    font-size: var(--font-size-sm);
    opacity: 0.9;
  }

  .weather-info {
    display: flex;
    align-items: center;
    gap: var(--spacing-4);
    flex: 1;
  }

  .weather-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    width: 40px;
    height: 40px;
  }

  .weather-icon svg {
    width: 100%;
    height: 100%;
  }

  .weather-temp {
    display: flex;
    align-items: flex-start;
  }

  .temp-value {
    font-family: var(--font-heading);
    font-size: var(--font-size-2xl);
    font-weight: var(--font-weight-bold);
    line-height: 1;
  }

  .temp-unit {
    font-size: var(--font-size-md);
    margin-top: var(--spacing-1);
  }

  .weather-details {
    flex: 1;
  }

  .weather-condition {
    font-size: var(--font-size-sm);
    font-weight: var(--font-weight-medium);
    margin-bottom: var(--spacing-1);
  }

  .weather-note {
    font-size: var(--font-size-xs);
    opacity: 0.8;
    margin-bottom: 0;
  }

  /* Map Section */
  .map-section {
    margin-bottom: var(--spacing-12);
  }

  .map-card {
    display: grid;
    grid-template-columns: 1fr 2fr;
    background-color: var(--color-background);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-xl);
    overflow: hidden;
  }

  .map-info {
    padding: var(--spacing-6);
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: var(--spacing-6);
  }

  .map-warning {
    font-size: var(--font-size-sm);
    color: var(--color-text-light);
    line-height: var(--line-height-relaxed);
    margin: 0;
  }

  .map-warning strong {
    color: var(--color-text);
  }

  .map-actions {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-3);
  }

  .map-container {
    min-height: 300px;
  }

  .map-container iframe {
    display: block;
    width: 100%;
    height: 100%;
  }

  /* Van Section */
  .van-section {
    margin-bottom: var(--spacing-12);
  }

  .van-intro {
    text-align: center;
    font-size: var(--font-size-base);
    color: var(--color-text-light);
    margin-bottom: var(--spacing-8);
    max-width: 500px;
    margin-left: auto;
    margin-right: auto;
  }

  .van-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: var(--spacing-6);
    margin-bottom: var(--spacing-4);
  }

  .van-card {
    background-color: var(--color-background);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-xl);
    overflow: hidden;
  }

  .van-card-header {
    display: flex;
    align-items: center;
    gap: var(--spacing-3);
    padding: var(--spacing-4) var(--spacing-6);
    background-color: var(--color-secondary);
  }

  .van-card-header svg {
    width: 24px;
    height: 24px;
    color: var(--color-primary);
  }

  .van-card-header h4 {
    font-family: var(--font-heading);
    font-size: var(--font-size-lg);
    color: var(--color-text);
    margin: 0;
  }

  .van-table {
    width: 100%;
    border-collapse: collapse;
  }

  .van-table th,
  .van-table td {
    padding: var(--spacing-3) var(--spacing-6);
    text-align: left;
  }

  .van-table th {
    font-size: var(--font-size-sm);
    font-weight: var(--font-weight-medium);
    color: var(--color-text-muted);
    text-transform: uppercase;
    letter-spacing: var(--letter-spacing-wide);
    border-bottom: 1px solid var(--color-border);
  }

  .van-table td {
    border-bottom: 1px solid var(--color-border-light);
  }

  .van-table tr:last-child td {
    border-bottom: none;
  }

  .van-time {
    font-family: var(--font-heading);
    font-weight: var(--font-weight-semibold);
    color: var(--color-primary);
  }

  .van-name {
    font-weight: var(--font-weight-semibold);
    color: var(--color-primary);
  }

  .van-location {
    font-weight: var(--font-weight-medium);
    color: var(--color-text);
  }

  .van-note {
    font-size: var(--font-size-sm);
    color: var(--color-text-muted);
    text-align: center;
    font-style: italic;
  }

  /* Transport Alternatives */
  .transport-alternatives {
    margin-bottom: var(--spacing-8);
  }

  .alternatives-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
    gap: var(--spacing-6);
  }

  .alternative-card {
    background-color: var(--color-background-alt);
    border-radius: var(--radius-lg);
    padding: var(--spacing-6);
    text-align: center;
  }

  .alternative-icon {
    width: 48px;
    height: 48px;
    margin: 0 auto var(--spacing-4);
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--color-primary);
  }

  .alternative-icon svg {
    width: 32px;
    height: 32px;
  }

  .alternative-card h4 {
    font-family: var(--font-heading);
    font-size: var(--font-size-lg);
    color: var(--color-text);
    margin-bottom: var(--spacing-2);
  }

  .alternative-card p {
    font-size: var(--font-size-sm);
    color: var(--color-text-light);
    margin-bottom: 0;
  }

  @media (max-width: 768px) {
    .event-grid {
      grid-template-columns: 1fr;
    }

    .schedule-weather-grid {
      grid-template-columns: 1fr;
    }

    .weather-card {
      flex-direction: column;
      text-align: center;
    }

    .weather-date {
      padding-right: 0;
      padding-bottom: var(--spacing-4);
      border-right: none;
      border-bottom: 1px solid var(--color-white-alpha-20);
    }

    .weather-info {
      flex-direction: column;
    }

    .schedule-item {
      flex-direction: column;
      align-items: flex-start;
      gap: var(--spacing-2);
    }

    .map-card {
      grid-template-columns: 1fr;
    }

    .map-container {
      min-height: 250px;
    }

    .map-actions {
      flex-direction: row;
      justify-content: center;
    }

    .van-grid {
      grid-template-columns: 1fr;
    }
  }
</style>

<script>
  // Weather data fetching using Open-Meteo API (no API key required)
  const WEDDING_DATE = '2026-04-10';
  const SAO_PAULO_LAT = -23.55;
  const SAO_PAULO_LON = -46.63;

  // Weather code descriptions in Portuguese
  const weatherDescriptions: Record<number, string> = {
    0: 'Céu limpo',
    1: 'Predominantemente limpo',
    2: 'Parcialmente nublado',
    3: 'Nublado',
    45: 'Neblina',
    48: 'Neblina com geada',
    51: 'Garoa leve',
    53: 'Garoa moderada',
    55: 'Garoa intensa',
    61: 'Chuva leve',
    63: 'Chuva moderada',
    65: 'Chuva forte',
    80: 'Pancadas de chuva leves',
    81: 'Pancadas de chuva moderadas',
    82: 'Pancadas de chuva fortes',
    95: 'Tempestade',
    96: 'Tempestade com granizo leve',
    99: 'Tempestade com granizo forte',
  };

  // Weather icons SVG
  const weatherIcons: Record<string, string> = {
    sunny: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
      <circle cx="12" cy="12" r="5"></circle>
      <line x1="12" y1="1" x2="12" y2="3"></line>
      <line x1="12" y1="21" x2="12" y2="23"></line>
      <line x1="4.22" y1="4.22" x2="5.64" y2="5.64"></line>
      <line x1="18.36" y1="18.36" x2="19.78" y2="19.78"></line>
      <line x1="1" y1="12" x2="3" y2="12"></line>
      <line x1="21" y1="12" x2="23" y2="12"></line>
      <line x1="4.22" y1="19.78" x2="5.64" y2="18.36"></line>
      <line x1="18.36" y1="5.64" x2="19.78" y2="4.22"></line>
    </svg>`,
    partlyCloudy: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
      <circle cx="9" cy="9" r="4"></circle>
      <line x1="9" y1="1" x2="9" y2="2"></line>
      <line x1="9" y1="16" x2="9" y2="17"></line>
      <line x1="2.64" y1="2.64" x2="3.35" y2="3.35"></line>
      <line x1="1" y1="9" x2="2" y2="9"></line>
      <line x1="2.64" y1="15.36" x2="3.35" y2="14.65"></line>
      <path d="M18.5 13H17a5 5 0 00-9.9 1h-.6a3.5 3.5 0 100 7h12a3.5 3.5 0 000-7z"></path>
    </svg>`,
    cloudy: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
      <path d="M18 10h-1.26A8 8 0 109 20h9a5 5 0 000-10z"></path>
    </svg>`,
    rainy: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
      <line x1="16" y1="13" x2="16" y2="21"></line>
      <line x1="8" y1="13" x2="8" y2="21"></line>
      <line x1="12" y1="15" x2="12" y2="23"></line>
      <path d="M20 16.58A5 5 0 0018 7h-1.26A8 8 0 104 15.25"></path>
    </svg>`,
    stormy: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
      <path d="M19 16.9A5 5 0 0018 7h-1.26a8 8 0 10-11.62 9"></path>
      <polyline points="13 11 9 17 15 17 11 23"></polyline>
    </svg>`,
    foggy: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
      <path d="M18 10h-1.26A8 8 0 109 20h9a5 5 0 000-10z"></path>
      <line x1="4" y1="14" x2="12" y2="14"></line>
      <line x1="2" y1="11" x2="8" y2="11"></line>
    </svg>`,
  };

  function getWeatherIcon(code: number): string {
    if (code === 0) return weatherIcons.sunny;
    if (code >= 1 && code <= 2) return weatherIcons.partlyCloudy;
    if (code === 3) return weatherIcons.cloudy;
    if (code >= 45 && code <= 48) return weatherIcons.foggy;
    if (code >= 51 && code <= 82) return weatherIcons.rainy;
    if (code >= 95) return weatherIcons.stormy;
    return weatherIcons.partlyCloudy;
  }

  function getWeatherDescription(code: number): string {
    return weatherDescriptions[code] || 'Parcialmente nublado';
  }

  async function fetchForecast(): Promise<{ temp: number; code: number } | null> {
    try {
      const url = `https://api.open-meteo.com/v1/forecast?latitude=${SAO_PAULO_LAT}&longitude=${SAO_PAULO_LON}&daily=temperature_2m_max,temperature_2m_min,weathercode&timezone=America/Sao_Paulo&start_date=${WEDDING_DATE}&end_date=${WEDDING_DATE}`;
      const response = await fetch(url);
      if (!response.ok) return null;

      const data = await response.json();
      if (data.daily && data.daily.temperature_2m_max && data.daily.temperature_2m_max.length > 0) {
        const maxTemp = data.daily.temperature_2m_max[0];
        const minTemp = data.daily.temperature_2m_min[0];
        const avgTemp = Math.round((maxTemp + minTemp) / 2);
        const code = data.daily.weathercode[0];
        return { temp: avgTemp, code };
      }
      return null;
    } catch {
      return null;
    }
  }

  async function fetchHistoricalAverage(): Promise<{ temp: number; code: number } | null> {
    try {
      // Fetch last 5 years of data for April 10th
      const currentYear = new Date().getFullYear();
      const years = [currentYear - 1, currentYear - 2, currentYear - 3, currentYear - 4, currentYear - 5];

      const temps: number[] = [];
      const codes: number[] = [];

      for (const year of years) {
        const date = `${year}-04-10`;
        const url = `https://archive-api.open-meteo.com/v1/archive?latitude=${SAO_PAULO_LAT}&longitude=${SAO_PAULO_LON}&start_date=${date}&end_date=${date}&daily=temperature_2m_max,temperature_2m_min,weathercode&timezone=America/Sao_Paulo`;

        try {
          const response = await fetch(url);
          if (response.ok) {
            const data = await response.json();
            if (data.daily && data.daily.temperature_2m_max && data.daily.temperature_2m_max[0] !== null) {
              const maxTemp = data.daily.temperature_2m_max[0];
              const minTemp = data.daily.temperature_2m_min[0];
              temps.push((maxTemp + minTemp) / 2);
              codes.push(data.daily.weathercode[0]);
            }
          }
        } catch {
          // Skip this year if there's an error
        }
      }

      if (temps.length === 0) return null;

      const avgTemp = Math.round(temps.reduce((a, b) => a + b, 0) / temps.length);
      // Get most common weather code
      const codeCount = codes.reduce((acc, code) => {
        acc[code] = (acc[code] || 0) + 1;
        return acc;
      }, {} as Record<number, number>);
      const mostCommonCode = Number(Object.entries(codeCount).sort((a, b) => b[1] - a[1])[0]?.[0]) || 2;

      return { temp: avgTemp, code: mostCommonCode };
    } catch {
      return null;
    }
  }

  function updateWeatherUI(temp: number, code: number, isHistorical: boolean) {
    const tempEl = document.getElementById('weatherTemp');
    const conditionEl = document.getElementById('weatherCondition');
    const noteEl = document.getElementById('weatherNote');
    const iconEl = document.getElementById('weatherIcon');

    if (tempEl) tempEl.textContent = String(temp);
    if (conditionEl) conditionEl.textContent = getWeatherDescription(code);
    if (iconEl) iconEl.innerHTML = getWeatherIcon(code);

    if (isHistorical) {
      if (noteEl) noteEl.textContent = 'Média histórica para 10 de abril em São Paulo.';
    } else {
      if (noteEl) noteEl.textContent = 'Previsão para o dia do casamento.';
    }
  }

  function showError() {
    const tempEl = document.getElementById('weatherTemp');
    const conditionEl = document.getElementById('weatherCondition');
    const noteEl = document.getElementById('weatherNote');

    if (tempEl) tempEl.textContent = '22';
    if (conditionEl) conditionEl.textContent = 'Parcialmente nublado';
    if (noteEl) noteEl.textContent = 'Estimativa baseada em médias históricas.';
  }

  async function initWeather() {
    const weddingDate = new Date(WEDDING_DATE);
    const today = new Date();
    const daysUntilWedding = Math.ceil((weddingDate.getTime() - today.getTime()) / (1000 * 60 * 60 * 24));

    // Open-Meteo forecast is available up to 16 days ahead
    if (daysUntilWedding <= 16 && daysUntilWedding > 0) {
      const forecast = await fetchForecast();
      if (forecast) {
        updateWeatherUI(forecast.temp, forecast.code, false);
        return;
      }
    }

    // Otherwise, use historical data
    const historical = await fetchHistoricalAverage();
    if (historical) {
      updateWeatherUI(historical.temp, historical.code, true);
    } else {
      showError();
    }
  }

  // Initialize on page load
  document.addEventListener('DOMContentLoaded', initWeather);
  document.addEventListener('astro:page-load', initWeather);
</script>
