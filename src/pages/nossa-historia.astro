---
import ProtectedLayout from '@/layouts/ProtectedLayout.astro';
import HeroDecoration from '@/components/HeroDecoration.astro';
---

<ProtectedLayout title="Nossa História">
  <section class="page-hero">
    <HeroDecoration variant="light" />
    <div class="container text-center">
      <p class="section-subtitle">A Jornada</p>
      <h1 class="page-title">Nossa História</h1>
    </div>
  </section>

  <section class="section timeline-section">
    <div class="container container-narrow">
      <div class="timeline">
        <!-- Timeline Item 1 -->
        <div class="timeline-item">
          <div class="timeline-marker"></div>
          <div class="timeline-content">
            <div class="timeline-image">
              <img src="https://drive.google.com/thumbnail?id=1TDrd48yL7UJVyxNiq2AehsH0LVRBsYzv&sz=w800" alt="Foto 1" />
              <span class="timeline-year">2010</span>
            </div>
            <p class="timeline-text">
              Dois adolescentes que não sabiam nada da vida, se conhecem e começam uma amizade.
            </p>
          </div>
        </div>

        <!-- Timeline Item 2 -->
        <div class="timeline-item">
          <div class="timeline-marker"></div>
          <div class="timeline-content">
            <div class="timeline-image">
              <img src="https://drive.google.com/thumbnail?id=1gRI6xYnm3d1xyXF8VsyCvFcpCI3ZePpn&sz=w800" alt="Foto 2" />
              <span class="timeline-year">2011</span>
            </div>
            <p class="timeline-text">
              Amizade genuína cheia de momentos de felicidade.
            </p>
          </div>
        </div>

        <!-- Timeline Item 3 -->
        <div class="timeline-item">
          <div class="timeline-marker"></div>
          <div class="timeline-content">
            <div class="timeline-image">
              <img src="https://drive.google.com/thumbnail?id=1ukC1RaKyvWv5EuU2yFFpQZxgvAv5Dy6-&sz=w800" alt="Foto 3" />
              <span class="timeline-year">2012</span>
            </div>
            <p class="timeline-text">
              A vida é engraçada e tentou dividi-los em faculdades rivais.
            </p>
          </div>
        </div>

        <!-- Timeline Item 4 -->
        <div class="timeline-item">
          <div class="timeline-marker"></div>
          <div class="timeline-content">
            <div class="timeline-image">
              <img src="https://drive.google.com/thumbnail?id=1b1tjUcx4qdqn5nbpyKRPe_r8Idw3NncO&sz=w800" alt="Foto 4" />
              <span class="timeline-year">2014</span>
            </div>
            <p class="timeline-text">
              Mas isso nem mexeu com a amizade.
            </p>
          </div>
        </div>

        <!-- Timeline Item 5 -->
        <div class="timeline-item">
          <div class="timeline-marker"></div>
          <div class="timeline-content">
            <div class="timeline-image">
              <img src="https://drive.google.com/thumbnail?id=1vccUqNgIgw3ojLFtep76v8RBhqA2MhUn&sz=w800" alt="Foto 5" />
              <span class="timeline-year">2015</span>
            </div>
            <p class="timeline-text">
              A vida chamou eles pra conhecer o mundo.
            </p>
          </div>
        </div>

        <!-- Timeline Item 6 -->
        <div class="timeline-item">
          <div class="timeline-marker"></div>
          <div class="timeline-content">
            <div class="timeline-image">
              <img src="https://drive.google.com/thumbnail?id=1owvAVUGZ_uBldU685pqgZE5CynrPoSGw&sz=w800" alt="Foto 6" />
              <span class="timeline-year">2015</span>
            </div>
            <p class="timeline-text">
              Não só ela, mas ele também.
            </p>
          </div>
        </div>

        <!-- Timeline Item 7 -->
        <div class="timeline-item">
          <div class="timeline-marker"></div>
          <div class="timeline-content">
            <div class="timeline-image">
              <img src="https://drive.google.com/thumbnail?id=1S8HqT707gVI_9b2hHgC4voTg3yRFv8-x&sz=w800" alt="Foto 7" />
              <span class="timeline-year">2017</span>
            </div>
            <p class="timeline-text">
              Quando finalmente cresceram, decidiram que realmente queriam estar juntos.
            </p>
          </div>
        </div>

        <!-- Timeline Item 8 -->
        <div class="timeline-item">
          <div class="timeline-marker"></div>
          <div class="timeline-content">
            <div class="timeline-image">
              <img src="https://drive.google.com/thumbnail?id=19ipfCiu90sN2Rt3-5S8IeH5n4WrJ15aR&sz=w800" alt="Foto 8" />
              <span class="timeline-year">2018</span>
            </div>
            <p class="timeline-text">
              Buscaram um lugar para chamar de lar.
            </p>
          </div>
        </div>

        <!-- Timeline Item 9 -->
        <div class="timeline-item">
          <div class="timeline-marker"></div>
          <div class="timeline-content">
            <div class="timeline-image">
              <img src="https://drive.google.com/thumbnail?id=1RpN-fnJWEbSBg034dxDdnNyk93ECtXO6&sz=w800" alt="Foto 9" />
              <span class="timeline-year">2022</span>
            </div>
            <p class="timeline-text">
              Decidiram construir uma família.
            </p>
          </div>
        </div>

        <!-- Timeline Item 10 -->
        <div class="timeline-item">
          <div class="timeline-marker"></div>
          <div class="timeline-content">
            <div class="timeline-image">
              <img src="https://drive.google.com/thumbnail?id=1UiVS0p6bTdzpq_HMYq-1cPLT1Lmw6_RT&sz=w800" alt="Foto 10" />
              <span class="timeline-year">2023</span>
            </div>
            <p class="timeline-text">
              E das alturas veio o primeiro pedido do "para sempre".
            </p>
          </div>
        </div>

        <!-- Timeline Item 11 -->
        <div class="timeline-item">
          <div class="timeline-marker"></div>
          <div class="timeline-content">
            <div class="timeline-collage">
              <img src="https://drive.google.com/thumbnail?id=1YloeQaU1LFFNn1ap5RdzhCJNBz56PIyW&sz=w400" alt="Foto 11a" />
              <img src="https://drive.google.com/thumbnail?id=1kzoknnkJu97vHwzmpqIn60_IKdMjpMf_&sz=w400" alt="Foto 11b" />
              <img src="https://drive.google.com/thumbnail?id=1hFW0Ile7R9Csw0QcM6TIeHOYJKefaO0z&sz=w400" alt="Foto 11c" />
              <img src="https://drive.google.com/thumbnail?id=1vrX9UV64DjGcnavBDuCMV1wVY7H7O2AP&sz=w400" alt="Foto 11d" />
            </div>
            <p class="timeline-text">
              Seguido de tantos outros pedidos e confirmações...
            </p>
          </div>
        </div>

        <!-- Timeline Item 12 -->
        <div class="timeline-item">
          <div class="timeline-marker"></div>
          <div class="timeline-content">
            <div class="timeline-image">
              <img src="https://drive.google.com/thumbnail?id=1Dkuh9WfNTH6jIM_T9OLZaDgyKz4PoHZl&sz=w800" alt="Foto 12" />
              <span class="timeline-year">2025</span>
            </div>
            <p class="timeline-text">
              E num novo país decidiram criar raízes.
            </p>
          </div>
        </div>

        <!-- Timeline Item 13 -->
        <div class="timeline-item">
          <div class="timeline-marker"></div>
          <div class="timeline-content">
            <div class="timeline-image">
              <img src="https://drive.google.com/thumbnail?id=1dEs5Z30HGk7c0C499_12uDjWsxZp7Mm5&sz=w800" alt="Foto 13" style="object-position: top;" />
              <span class="timeline-year">2025</span>
            </div>
            <p class="timeline-text">
              Hoje convidam para celebrar essa união.
            </p>
          </div>
        </div>
      </div>

      <div class="story-quote text-center">
        <blockquote>"O amor não se define. Sente-se."</blockquote>
      </div>
    </div>
  </section>
</ProtectedLayout>

<style>
  .page-hero {
    position: relative;
    overflow: hidden;
    padding: var(--spacing-24) var(--spacing-6) var(--spacing-16);
    background: linear-gradient(135deg, var(--color-secondary-light) 0%, var(--color-secondary) 100%);
  }

  .page-title {
    font-family: var(--font-script);
    font-size: var(--font-size-4xl);
    color: var(--color-primary);
    margin-bottom: 0;
  }

  .timeline-section {
    background-color: var(--color-background);
  }

  .timeline {
    position: relative;
    padding-left: var(--spacing-10);
  }

  .timeline::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0;
    bottom: 0;
    width: 2px;
    background: linear-gradient(to bottom, var(--color-primary), var(--color-accent));
  }

  .timeline-item {
    position: relative;
    margin-bottom: var(--spacing-12);
  }

  .timeline-item:last-child {
    margin-bottom: 0;
  }

  .timeline-marker {
    position: absolute;
    left: calc(-1 * var(--spacing-10) - 6px);
    top: 0;
    width: 14px;
    height: 14px;
    background-color: var(--color-primary);
    border: 3px solid var(--color-background);
    border-radius: 50%;
    box-shadow: 0 0 0 4px var(--color-primary-light);
  }

  .timeline-content {
    background-color: var(--color-background);
    padding: var(--spacing-6);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-md);
  }

  .timeline-text {
    color: var(--color-text-light);
    line-height: var(--line-height-relaxed);
    margin-top: var(--spacing-4);
    margin-bottom: 0;
    font-size: var(--font-size-lg);
  }

  .timeline-image-placeholder {
    width: 100%;
    aspect-ratio: 4 / 3;
    background-color: var(--color-secondary);
    border-radius: var(--radius-md);
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--color-text-muted);
    font-size: var(--font-size-sm);
  }

  .timeline-image {
    position: relative;
    width: 100%;
    aspect-ratio: 4 / 3;
    border-radius: var(--radius-md);
    overflow: hidden;
  }

  .timeline-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .timeline-collage {
    display: grid;
    grid-template-columns: 1fr 1fr;
    grid-template-rows: 1fr 1fr;
    gap: 4px;
    width: 100%;
    aspect-ratio: 4 / 3;
    border-radius: var(--radius-md);
    overflow: hidden;
  }

  .timeline-collage img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    display: block;
    min-height: 0;
  }

  .timeline-year {
    position: absolute;
    bottom: var(--spacing-3);
    right: var(--spacing-3);
    font-family: var(--font-script);
    font-size: 4rem;
    font-weight: var(--font-weight-bold);
    color: var(--color-accent);
    text-shadow: 2px 2px 4px rgba(0, 0, 0, 0.5);
  }

  .story-quote {
    margin-top: var(--spacing-16);
    padding: var(--spacing-8) var(--spacing-8) 0;
  }

  .story-quote blockquote {
    font-family: var(--font-heading);
    font-size: var(--font-size-2xl);
    font-style: italic;
    color: var(--color-primary);
    position: relative;
  }


  @media (max-width: 768px) {
    .timeline {
      padding-left: var(--spacing-8);
    }

    .timeline-marker {
      left: calc(-1 * var(--spacing-8) - 6px);
    }

    .timeline-content {
      padding: var(--spacing-4);
    }
  }
</style>
