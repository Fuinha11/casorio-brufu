---
import ProtectedLayout from '@/layouts/ProtectedLayout.astro';
import HeroDecoration from '@/components/HeroDecoration.astro';

const gifts = [
  {
    id: 'workshop-name',
    name: 'Seu nome na oficina',
    description: 'Grave seu nome em uma plaquinha especial na nossa oficina de marcenaria',
    value: 50,
    icon: 'hammer'
  },
  {
    id: 'bathroom-color',
    name: 'Escolha a cor do banheiro',
    description: 'Você decide a cor da pintura do nosso lavabo! Venha com sugestões criativas',
    value: 300,
    icon: 'paint'
  },
  {
    id: 'garden-plant',
    name: 'Planta no jardim',
    description: 'Escolha uma planta ou árvore que plantaremos no jardim com seu nome',
    value: 180,
    icon: 'plant'
  },
  {
    id: 'land-sqm',
    name: '1m² do nosso terreno',
    description: 'Adote um pedacinho do nosso terreno e ajude a construir nosso lar',
    value: 1000,
    icon: 'grass'
  },
  {
    id: 'knife-set',
    name: 'Jogo de facas pro noivo',
    description: 'Um conjunto de facas profissionais para o noivo que adora cozinhar',
    value: 250,
    icon: 'knife',
    easterEgg: true
  },
  {
    id: 'pomegranate-bag',
    name: 'Saco de romãs',
    description: 'Ganhe um saco de romãs do nosso jardim para dar sorte e prosperidade',
    value: 90,
    icon: 'fruit'
  },
  {
    id: 'honeymoon-night',
    name: 'Noite na lua de mel',
    description: 'Ajude a custear uma noite de hospedagem na nossa viagem',
    value: 500,
    icon: 'hotel'
  },
  {
    id: 'extra-guest',
    name: 'Levar convidado adicional',
    description: 'Traga um +1 para a festa! Sujeito a aprovação dos noivos. Não reembolsável.',
    value: 10000,
    icon: 'user-plus'
  },
  {
    id: 'surprise',
    name: 'Presente surpresa',
    description: 'Escolha o valor e deixe uma mensagem especial para nós',
    value: 0,
    icon: 'gift',
    customValue: true
  },
];

const giftsJson = JSON.stringify(gifts);
---

<ProtectedLayout title="Lista de Presentes">
  <section class="page-hero">
    <HeroDecoration variant="light" />
    <div class="container text-center">
      <p class="section-subtitle">Presenteie</p>
      <h1 class="page-title">Lista de Presentes</h1>
    </div>
  </section>

  <section class="section gifts-section">
    <div class="container">
      <div class="gifts-intro text-center">
        <p class="gifts-intro-text">
          Sua presença é o maior presente que poderíamos receber!
          Mas se desejar nos presentear, temos algumas listas e ideias especiais.
        </p>
      </div>

      <!-- Registry Links -->
      <div class="registry-grid">
        <a href="https://www.amazon.es/wedding/guest-view/21LK9A62UCQVA" class="registry-card" target="_blank" rel="noopener noreferrer">
          <div class="registry-icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
              <path d="M21 8l-2 2m0 0l-2-2m2 2v-6"></path>
              <path d="M3 8l2 2m0 0l2-2m-2 2V4"></path>
              <rect x="3" y="14" width="18" height="8" rx="2"></rect>
              <path d="M12 14v8"></path>
            </svg>
          </div>
          <h3 class="registry-title">Bugigangas legais que vamos gostar</h3>
          <p class="registry-description">
            Presentes divertidos e úteis que escolhemos na Amazon
          </p>
          <span class="registry-btn-text">Ver lista na Amazon →</span>
        </a>

        <a href="https://www.elcorteingles.pt/presentes/casamentos/eventos/nrbgmm-casamento-de-bruna-e-marcos--e-marcos/" class="registry-card" target="_blank" rel="noopener noreferrer">
          <div class="registry-icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
              <path d="M6 2L3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"></path>
              <line x1="3" y1="6" x2="21" y2="6"></line>
              <path d="M16 10a4 4 0 0 1-8 0"></path>
            </svg>
          </div>
          <h3 class="registry-title">Presentes tradicionais de casamento</h3>
          <p class="registry-description">
            Lista clássica de casamento no El Corte Inglés
          </p>
          <span class="registry-btn-text">Ver lista no El Corte Inglés →</span>
        </a>
      </div>

      <!-- Section Separator -->
      <div class="section-separator">
        <div class="separator-line"></div>
        <p class="separator-text">
          Quer também dar um presente único que não vende em loja? Veja algumas ideias:
        </p>
        <div class="separator-line"></div>
      </div>

      <!-- Unique/Creative Gifts Grid -->
      <div class="gift-grid">
        {gifts.map((gift) => (
          <button
            class="gift-card"
            data-gift-id={gift.id}
            data-gift-name={gift.name}
            data-gift-value={gift.value}
            data-custom-value={gift.customValue || false}
            data-easter-egg={gift.easterEgg || false}
          >
            <div class="gift-icon" data-icon={gift.icon}>
              {gift.icon === 'hammer' && (
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                  <path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z"></path>
                </svg>
              )}
              {gift.icon === 'paint' && (
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                  <path d="M19 11h-6a2 2 0 0 0-2 2v6a2 2 0 0 0 2 2h6a2 2 0 0 0 2-2v-6a2 2 0 0 0-2-2z"></path>
                  <path d="M12 11V5a2 2 0 0 1 2-2h6a2 2 0 0 1 2 2v4a2 2 0 0 1-2 2h-1"></path>
                  <path d="M7 19H5a2 2 0 0 1-2-2v-6a2 2 0 0 1 2-2h4"></path>
                </svg>
              )}
              {gift.icon === 'plant' && (
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                  <path d="M12 22v-7"></path>
                  <path d="M9 22h6"></path>
                  <path d="M12 15c-3.5 0-7-2-7-6 2 0 4.5.5 7 3 2.5-2.5 5-3 7-3 0 4-3.5 6-7 6z"></path>
                </svg>
              )}
              {gift.icon === 'grass' && (
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                  <path d="M4 20h16"></path>
                  <path d="M4 20c0-8 2-14 4-14s2 6 2 14"></path>
                  <path d="M10 20c0-6 2-10 4-10s2 4 2 10"></path>
                  <path d="M14 20c0-8 2-12 4-12s2 4 2 12"></path>
                </svg>
              )}
              {gift.icon === 'fruit' && (
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                  <circle cx="12" cy="14" r="7"></circle>
                  <path d="M12 7V4"></path>
                  <path d="M9 6c0-1 1-2 3-2s3 1 3 2"></path>
                  <path d="M12 14v3"></path>
                  <path d="M9 13l1 2"></path>
                  <path d="M15 13l-1 2"></path>
                </svg>
              )}
              {gift.icon === 'hotel' && (
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                  <path d="M3 21h18"></path>
                  <path d="M5 21V7l8-4v18"></path>
                  <path d="M19 21V11l-6-4"></path>
                  <path d="M9 9h1"></path>
                  <path d="M9 13h1"></path>
                  <path d="M9 17h1"></path>
                </svg>
              )}
              {gift.icon === 'user-plus' && (
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                  <path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"></path>
                  <circle cx="9" cy="7" r="4"></circle>
                  <line x1="19" y1="8" x2="19" y2="14"></line>
                  <line x1="22" y1="11" x2="16" y2="11"></line>
                </svg>
              )}
              {gift.icon === 'gift' && (
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                  <path d="M12 8v13m0-13V6a2 2 0 112 2h-2zm0 0V5.5A2.5 2.5 0 109.5 8H12zm-7 4h14M5 12a2 2 0 110-4h14a2 2 0 110 4M5 12v7a2 2 0 002 2h10a2 2 0 002-2v-7"></path>
                </svg>
              )}
              {gift.icon === 'knife' && (
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                  <path d="M7.05 3.05L3.05 7.05M21.95 16.95L7.05 2.05c-.39-.39-1.02-.39-1.41 0L3.05 4.64c-.39.39-.39 1.02 0 1.41l14.9 14.9c.39.39 1.02.39 1.41 0l2.59-2.59c.39-.39.39-1.02 0-1.41z"></path>
                  <path d="M14 8l-3 3"></path>
                  <path d="M17 11l-3 3"></path>
                </svg>
              )}
            </div>
            <h4 class="gift-name">{gift.name}</h4>
            <p class="gift-description">{gift.description}</p>
            <p class="gift-value">
              {gift.customValue ? 'Valor livre' : `R$ ${gift.value}`}
            </p>
          </button>
        ))}
      </div>

    </div>
  </section>

  <!-- Gift Modal -->
  <div class="gift-modal" id="giftModal">
    <div class="gift-modal-overlay"></div>
    <div class="gift-modal-content">
      <button class="gift-modal-close" id="closeModal">&times;</button>

      <h2 class="gift-modal-title">Confirmar Presente</h2>
      <p class="gift-modal-subtitle" id="selectedGiftName"></p>

      <!-- Gift Image (for special gifts like lixadeira) -->
      <div class="gift-modal-image" id="giftModalImage" style="display: none;">
        <img id="giftModalImageSrc" src="" alt="" />
        <a href="" target="_blank" class="gift-modal-image-link" id="giftModalImageLink" style="display: none;"></a>
      </div>

      <!-- QR Code Section -->
      <div class="plox-qr-section" id="ploxQrSection">
        <div class="plox-qr-code" id="ploxQrCode"></div>
        <p class="plox-qr-value">Valor: <strong id="ploxQrValue">R$ 0</strong></p>
        <p class="plox-qr-hint">Escaneie o QR Code com o app do seu banco</p>
        <button type="button" class="plox-copy-code-btn" id="copyPloxCode">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="16" height="16">
            <rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect>
            <path d="M5 15H4a2 2 0 01-2-2V4a2 2 0 012-2h9a2 2 0 012 2v1"></path>
          </svg>
          Copiar código
        </button>
      </div>

      <div class="modal-divider">
        <span>Após o pagamento, confirme abaixo</span>
      </div>

      <form id="giftForm" class="gift-form">
        <input type="hidden" id="giftId" name="giftId" />
        <input type="hidden" id="guestCode" name="guestCode" />
        <input type="hidden" id="ploxCode" name="ploxCode" />

        <div class="form-group">
          <label for="guestName">Seu nome</label>
          <input type="text" id="guestName" name="guestName" required readonly />
        </div>

        <div class="form-group">
          <label for="giftValue">Valor (R$)</label>
          <input type="number" id="giftValue" name="giftValue" min="1" required />
        </div>

        <div class="form-group">
          <label for="message">Mensagem (opcional)</label>
          <textarea id="message" name="message" rows="3" placeholder="Deixe uma mensagem especial para os noivos"></textarea>
        </div>

        <div class="form-group">
          <label for="receipt">Comprovante de transferência</label>
          <div class="file-upload" id="fileUpload">
            <input type="file" id="receipt" name="receipt" accept="image/*,.pdf" />
            <div class="file-upload-content">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
                <polyline points="17,8 12,3 7,8"></polyline>
                <line x1="12" y1="3" x2="12" y2="15"></line>
              </svg>
              <span class="file-upload-text">Clique ou arraste o arquivo</span>
              <span class="file-upload-hint">PNG, JPG ou PDF (máx. 5MB)</span>
            </div>
            <div class="file-preview" id="filePreview" style="display: none;">
              <span class="file-name" id="fileName"></span>
              <button type="button" class="file-remove" id="removeFile">&times;</button>
            </div>
          </div>
        </div>

        <div class="form-message" id="formMessage"></div>

        <button type="submit" class="btn btn-primary btn-lg btn-block" id="submitBtn">
          <span class="btn-text">Enviar Confirmação</span>
          <span class="btn-loading" style="display: none;">
            <svg class="spinner" viewBox="0 0 24 24">
              <circle cx="12" cy="12" r="10" stroke="currentColor" stroke-width="3" fill="none" stroke-dasharray="30 70"></circle>
            </svg>
            Enviando...
          </span>
        </button>
      </form>
    </div>
  </div>

  <!-- Easter Egg Modal -->
  <div class="easter-egg-modal" id="easterEggModal">
    <div class="easter-egg-overlay"></div>
    <div class="easter-egg-content">
      <div class="easter-egg-image">
        <img src="/casorio-brufu/images/fuck-you.png" alt="Sério mesmo?" />
      </div>
      <div class="easter-egg-body">
        <h2 class="easter-egg-title">Tá de brincadeira comigo?!</h2>
        <p class="easter-egg-text">
          Quer dar faca genérica chulé pro noivo?<br/>
          Paga logo uma lixadeira que ele mesmo faz melhor!
        </p>
        <div class="easter-egg-buttons">
          <button class="btn btn-secondary easter-egg-btn" id="easterEggClose">
            Sou ramelão, vou dar outra coisa
          </button>
          <button class="btn btn-primary easter-egg-btn" id="easterEggAccept">
            Quero ver ele fazer!
          </button>
        </div>
      </div>
    </div>
  </div>
</ProtectedLayout>

<style>
  .page-hero {
    position: relative;
    overflow: hidden;
    padding: var(--spacing-24) var(--spacing-6) var(--spacing-16);
    background: linear-gradient(135deg, var(--color-secondary-light) 0%, var(--color-secondary) 100%);
  }

  .page-title {
    font-family: var(--font-script);
    font-size: var(--font-size-4xl);
    color: var(--color-primary);
    margin-bottom: 0;
  }

  .gifts-section {
    background-color: var(--color-background);
  }

  .gifts-intro {
    margin-bottom: var(--spacing-12);
  }

  .gifts-intro-text {
    font-size: var(--font-size-lg);
    color: var(--color-text-light);
    line-height: var(--line-height-relaxed);
    max-width: 600px;
    margin: 0 auto;
  }

  /* Gift Grid */
  .gift-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: var(--spacing-6);
    margin-bottom: var(--spacing-12);
  }

  /* Section Separator */
  .section-separator {
    display: flex;
    align-items: center;
    gap: var(--spacing-6);
    margin: var(--spacing-16) 0;
    padding: var(--spacing-8) 0;
  }

  .separator-line {
    flex: 1;
    height: 2px;
    background: linear-gradient(90deg, transparent, var(--color-primary), transparent);
  }

  .separator-text {
    font-family: var(--font-heading);
    font-size: var(--font-size-lg);
    color: var(--color-text-light);
    text-align: center;
    max-width: 400px;
    line-height: var(--line-height-relaxed);
    margin: 0;
  }

  @media (max-width: 768px) {
    .section-separator {
      flex-direction: column;
      gap: var(--spacing-4);
    }

    .separator-line {
      width: 60%;
      height: 1px;
    }

    .separator-text {
      font-size: var(--font-size-base);
    }
  }

  /* Registry Grid */
  .registry-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--spacing-6);
    margin-bottom: var(--spacing-8);
  }

  @media (max-width: 768px) {
    .registry-grid {
      grid-template-columns: 1fr;
    }
  }

  .registry-card {
    display: block;
    background-color: var(--color-secondary);
    border: 2px solid var(--color-border);
    border-radius: var(--radius-xl);
    padding: var(--spacing-8);
    text-align: center;
    text-decoration: none;
    transition: all var(--transition-normal);
  }

  .registry-card:hover {
    border-color: var(--color-primary);
    transform: translateY(-4px);
    box-shadow: var(--shadow-lg);
  }

  .registry-card:hover .registry-icon {
    background-color: var(--color-primary-dark);
    transform: scale(1.05);
  }

  .registry-card:hover .registry-btn-text {
    color: var(--color-primary-dark);
  }

  .registry-icon {
    width: 72px;
    height: 72px;
    margin: 0 auto var(--spacing-4);
    display: flex;
    align-items: center;
    justify-content: center;
    background-color: var(--color-primary);
    border-radius: var(--radius-full);
    color: var(--color-text-inverse);
    transition: all var(--transition-normal);
  }

  .registry-icon svg {
    width: 36px;
    height: 36px;
  }

  .registry-title {
    font-family: var(--font-heading);
    font-size: var(--font-size-lg);
    color: var(--color-text);
    margin-bottom: var(--spacing-2);
  }

  .registry-description {
    font-size: var(--font-size-sm);
    color: var(--color-text-light);
    margin-bottom: var(--spacing-4);
    line-height: var(--line-height-relaxed);
  }

  .registry-btn-text {
    display: inline-block;
    font-family: var(--font-heading);
    font-size: var(--font-size-sm);
    font-weight: var(--font-weight-semibold);
    color: var(--color-primary);
    transition: color var(--transition-fast);
  }

  .gift-card {
    background-color: var(--color-background);
    border: 2px solid var(--color-border);
    border-radius: var(--radius-xl);
    padding: var(--spacing-8);
    text-align: center;
    cursor: pointer;
    transition: all var(--transition-normal);
  }

  .gift-card:hover {
    border-color: var(--color-primary);
    transform: translateY(-4px);
    box-shadow: var(--shadow-lg);
  }

  .gift-icon {
    width: 64px;
    height: 64px;
    margin: 0 auto var(--spacing-4);
    display: flex;
    align-items: center;
    justify-content: center;
    background-color: var(--color-secondary);
    border-radius: var(--radius-full);
    color: var(--color-primary);
    transition: all var(--transition-normal);
  }

  .gift-card:hover .gift-icon {
    background-color: var(--color-primary);
    color: var(--color-text-inverse);
  }

  .gift-icon svg {
    width: 32px;
    height: 32px;
  }

  .gift-name {
    font-family: var(--font-heading);
    font-size: var(--font-size-lg);
    color: var(--color-text);
    margin-bottom: var(--spacing-2);
  }

  .gift-description {
    font-size: var(--font-size-sm);
    color: var(--color-text-light);
    margin-bottom: var(--spacing-4);
    line-height: var(--line-height-relaxed);
  }

  .gift-value {
    font-family: var(--font-heading);
    font-size: var(--font-size-xl);
    font-weight: var(--font-weight-semibold);
    color: var(--color-primary);
    margin-bottom: 0;
  }

  /* Modal */
  .gift-modal {
    position: fixed;
    inset: 0;
    z-index: var(--z-modal);
    display: flex;
    align-items: center;
    justify-content: center;
    padding: var(--spacing-4);
    opacity: 0;
    visibility: hidden;
    transition: all var(--transition-normal);
  }

  .gift-modal.active {
    opacity: 1;
    visibility: visible;
  }

  .gift-modal-overlay {
    position: absolute;
    inset: 0;
    background-color: var(--color-overlay-backdrop);
    backdrop-filter: blur(4px);
  }

  .gift-modal-content {
    position: relative;
    background-color: var(--color-background);
    border-radius: var(--radius-xl);
    padding: var(--spacing-8);
    max-width: 500px;
    width: 100%;
    max-height: 90vh;
    overflow-y: auto;
    transform: translateY(20px);
    transition: transform var(--transition-normal);
  }

  .gift-modal.active .gift-modal-content {
    transform: translateY(0);
  }

  .gift-modal-close {
    position: absolute;
    top: var(--spacing-4);
    right: var(--spacing-4);
    width: 32px;
    height: 32px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: none;
    border: none;
    font-size: 24px;
    color: var(--color-text-light);
    cursor: pointer;
    transition: color var(--transition-fast);
  }

  .gift-modal-close:hover {
    color: var(--color-text);
  }

  .gift-modal-title {
    font-family: var(--font-heading);
    font-size: var(--font-size-2xl);
    color: var(--color-text);
    margin-bottom: var(--spacing-1);
  }

  .gift-modal-subtitle {
    font-size: var(--font-size-base);
    color: var(--color-primary);
    margin-bottom: var(--spacing-6);
  }

  /* Gift Modal Image */
  .gift-modal-image {
    margin-bottom: var(--spacing-6);
    border-radius: var(--radius-lg);
    overflow: hidden;
    background-color: var(--color-secondary);
    text-align: center;
  }

  .gift-modal-image img {
    width: 100%;
    max-height: 200px;
    object-fit: cover;
  }

  .gift-modal-image-link {
    display: block;
    padding: var(--spacing-3);
    font-size: var(--font-size-sm);
    color: var(--color-primary-alt);
    text-decoration: underline;
    background-color: var(--color-background);
    transition: color var(--transition-fast);
  }

  .gift-modal-image-link:hover {
    color: var(--color-primary-alt-dark);
  }

  /* QR Code */
  .plox-qr-section {
