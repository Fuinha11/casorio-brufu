---
import ProtectedLayout from '@/layouts/ProtectedLayout.astro';
import HeroDecoration from '@/components/HeroDecoration.astro';
---

<ProtectedLayout title="Confirmar Presença">
  <!-- RSVP Overlay -->
  <div class="rsvp-overlay">
    <div class="rsvp-overlay-content">
      <div class="rsvp-overlay-icon">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
          <path d="M12 9v3.75m9-.75a9 9 0 11-18 0 9 9 0 0118 0zm-9 3.75h.008v.008H12v-.008z"></path>
        </svg>
      </div>
      <h2 class="rsvp-overlay-title">Atenção!</h2>
      <p class="rsvp-overlay-text">
        Avisamos que a Amanda iria fazer bullying com que não confirmasse. Daqui pra frente essa etapa é com ela, você irá receber uma mensagem no WhatsApp com o link!
      </p>
    </div>
  </div>
  <!-- End RSVP Overlay -->

  <section class="rsvp-hero">
    <HeroDecoration variant="light" />
    <div class="rsvp-hero-content">
      <span class="rsvp-subtitle">RSVP</span>
      <h1 class="rsvp-title">Confirmar Presença</h1>
    </div>
  </section>

  <section class="rsvp-main">
    <div class="rsvp-container">
      <p class="rsvp-intro">
        Por favor, confirme sua presença até <strong>15 de março de 2026</strong>.
      </p>

      <div class="rsvp-alert">
        <span class="rsvp-alert-icon">!</span>
        <span>Por favor revise seus dados! Eles serao usados para controle de entrada. A Amanda, nossa assessora, tem ordens expressas de fazer bullying em quem não confirmar.</span>
      </div>

      <div id="rsvpLoading" class="rsvp-loading">
        <div class="rsvp-spinner"></div>
        <p>Carregando seus dados...</p>
      </div>

      <form id="rsvpForm" class="rsvp-form" style="display: none;">
        <div id="guestsList"></div>

        <button type="button" id="addGuestBtn" class="rsvp-add-btn">
          + Adicionar outro convidado
        </button>

        <div id="formMessage" class="rsvp-message"></div>

        <button type="submit" id="submitBtn" class="rsvp-submit-btn">
          Confirmar Presença
        </button>
      </form>
    </div>
  </section>

  <div id="modal" class="rsvp-modal">
    <div class="rsvp-modal-overlay"></div>
    <div class="rsvp-modal-box">
      <button type="button" id="closeModalBtn" class="rsvp-modal-close">&times;</button>
      <h3 class="rsvp-modal-title">Adicionar Convidado</h3>
      <p class="rsvp-modal-text">Digite o código do convite:</p>
      <input type="text" id="modalCodeInput" class="rsvp-modal-input" placeholder="Ex: maria2026" />
      <button type="button" id="validateBtn" class="rsvp-modal-btn">Validar</button>
      <p id="modalError" class="rsvp-modal-error"></p>
    </div>
  </div>
</ProtectedLayout>

<style is:global>
  /* Hero */
  .rsvp-hero {
    position: relative;
    overflow: hidden;
    padding: 6rem 1.5rem 4rem;
    background: linear-gradient(135deg, var(--color-secondary-light) 0%, var(--color-secondary-dark) 100%);
    text-align: center;
  }
  .rsvp-hero-content {
    max-width: 600px;
    margin: 0 auto;
  }
  .rsvp-subtitle {
    display: block;
    font-size: 0.875rem;
    text-transform: uppercase;
    letter-spacing: 0.2em;
    color: var(--color-text-muted);
    margin-bottom: 0.5rem;
  }
  .rsvp-title {
    font-family: var(--font-script);
    font-size: 2.5rem;
    color: var(--color-primary);
    margin: 0;
  }

  /* Main */
  .rsvp-main {
    background: var(--color-background-alt);
    padding: 3rem 1.5rem;
    min-height: 60vh;
  }
  .rsvp-container {
    max-width: 600px;
    margin: 0 auto;
  }
  .rsvp-intro {
    text-align: center;
    margin-bottom: 1.5rem;
    color: var(--color-text-light);
    font-size: 1rem;
  }

  /* Loading Spinner */
  .rsvp-loading {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: 3rem;
    text-align: center;
  }
  .rsvp-loading p {
    margin-top: 1rem;
    color: var(--color-text-light);
    font-size: 0.95rem;
  }
  .rsvp-spinner {
    width: 40px;
    height: 40px;
    border: 3px solid var(--color-input-border-dark);
    border-top-color: var(--color-primary);
    border-radius: 50%;
    animation: rsvp-spin 0.8s linear infinite;
  }
  @keyframes rsvp-spin {
    to { transform: rotate(360deg); }
  }

  /* Alert */
  .rsvp-alert {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 1rem 1.25rem;
    background: var(--color-accent-bg);
    border-left: 4px solid var(--color-accent);
    border-radius: 8px;
    margin-bottom: 2rem;
    color: var(--color-accent-text-dark);
    font-size: 0.9rem;
    font-weight: 600;
  }
  .rsvp-alert-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 24px;
    height: 24px;
    background: var(--color-accent);
    color: var(--color-white);
    border-radius: 50%;
    font-weight: bold;
    font-size: 0.875rem;
    flex-shrink: 0;
  }

  /* Guest Card */
  .rsvp-card {
    background: var(--color-background);
    border-radius: 16px;
    padding: 0;
    margin-bottom: 1.5rem;
    box-shadow: 0 4px 20px var(--color-shadow-md);
    position: relative;
    overflow: hidden;
  }
  .rsvp-card-remove {
    position: absolute;
    top: 1rem;
    right: 1rem;
    width: 28px;
    height: 28px;
    border: none;
    background: var(--color-input-disabled);
    border-radius: 50%;
    cursor: pointer;
    font-size: 1.25rem;
    color: var(--color-text-muted);
    display: flex;
    align-items: center;
    justify-content: center;
    line-height: 1;
    z-index: 1;
  }
  .rsvp-card-remove:hover {
    background: var(--color-danger);
    color: var(--color-white);
  }

  /* Card Row */
  .rsvp-row {
    display: flex;
    align-items: center;
    padding: 1rem 1.5rem;
    border-bottom: 1px solid var(--color-input-disabled);
  }
  .rsvp-row:last-child {
    border-bottom: none;
  }
  .rsvp-row-label {
    width: 130px;
    flex-shrink: 0;
    font-size: 0.8rem;
    font-weight: 700;
    color: var(--color-text-light);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }
  .rsvp-row-content {
    flex: 1;
    min-width: 0;
  }

  /* Code Display */
  .rsvp-code-display {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }
  .rsvp-code-text {
    font-family: var(--font-heading);
    font-size: 1.1rem;
    font-weight: 700;
    color: var(--color-primary);
    text-transform: uppercase;
    letter-spacing: 0.1em;
  }
  .rsvp-status {
    font-size: 0.65rem;
    padding: 0.25rem 0.6rem;
    border-radius: 20px;
    text-transform: uppercase;
    font-weight: 700;
    letter-spacing: 0.03em;
  }
  .rsvp-status.pending {
    background: var(--color-input-disabled);
    color: var(--color-input-placeholder);
  }
  .rsvp-status.confirmed {
    background: var(--color-success-bg-light);
    color: var(--color-success-dark);
  }
  .rsvp-status.not-going {
    background: var(--color-error-bg-light);
    color: var(--color-error-dark);
  }

  /* Name Input */
  .rsvp-name-input {
    width: 100%;
    padding: 0.6rem 0.875rem;
    font-size: 0.95rem;
    border: 2px solid var(--color-input-border-dark);
    border-radius: 8px;
    background: var(--color-input-bg);
    color: var(--color-text);
    font-family: inherit;
    box-sizing: border-box;
  }
  .rsvp-name-input:focus {
    outline: none;
    border-color: var(--color-primary);
    background: var(--color-background);
  }

  /* Attendance */
  .rsvp-attendance {
    display: flex;
    gap: 0.5rem;
  }
  .rsvp-attendance-btn {
    padding: 0.5rem 1rem;
    border: 2px solid var(--color-input-border);
    border-radius: 25px;
    background: var(--color-input-bg);
    cursor: pointer;
    font-size: 0.875rem;
    font-weight: 500;
    color: var(--color-text-light);
    display: flex;
    align-items: center;
    gap: 0.4rem;
    transition: all 0.15s ease;
  }
  .rsvp-attendance-btn:hover {
    background: var(--color-input-disabled);
  }
  .rsvp-attendance-btn.yes.active {
    border-color: var(--color-success);
    background: var(--color-success-bg-hover);
    color: var(--color-success-dark);
  }
  .rsvp-attendance-btn.no.active {
    border-color: var(--color-error);
    background: var(--color-error-bg-hover);
    color: var(--color-error-dark);
  }

  /* Dietary */
  .rsvp-dietary {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }
  .rsvp-dietary-item {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.4rem 0.8rem;
    background: var(--color-input-bg);
    border: 2px solid var(--color-input-border);
    border-radius: 25px;
    cursor: pointer;
    font-size: 0.8rem;
    color: var(--color-text-light);
    transition: all 0.15s ease;
  }
  .rsvp-dietary-item:hover {
    background: var(--color-input-disabled);
  }
  .rsvp-dietary-item.active {
    border-color: var(--color-primary);
    background: rgba(var(--color-primary-rgb), 0.1);
  }
  .rsvp-dietary-item input[type="checkbox"] {
    width: 14px;
    height: 14px;
    accent-color: var(--color-primary);
    margin: 0;
  }

  /* Allergy Detail */
  .rsvp-allergy {
    display: none;
    align-items: center;
    gap: 0.6rem;
    margin-top: 0.75rem;
  }
  .rsvp-allergy.show {
    display: flex;
  }
  .rsvp-allergy-label {
    font-size: 0.8rem;
    color: var(--color-text-light);
    white-space: nowrap;
  }
  .rsvp-allergy-input {
    flex: 1;
    padding: 0.5rem 0.75rem;
    font-size: 0.85rem;
    border: 2px solid var(--color-input-border);
    border-radius: 6px;
    background: var(--color-input-bg);
    font-family: inherit;
    box-sizing: border-box;
  }
  .rsvp-allergy-input:focus {
    outline: none;
    border-color: var(--color-primary);
    background: var(--color-background);
  }

  /* Van Selection */
  .rsvp-van {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }
  .rsvp-van-item {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.4rem 0.8rem;
    background: var(--color-input-bg);
    border: 2px solid var(--color-input-border);
    border-radius: 25px;
    cursor: pointer;
    font-size: 0.8rem;
    color: var(--color-text-light);
    transition: all 0.15s ease;
  }
  .rsvp-van-item:hover {
    background: var(--color-input-disabled);
  }
  .rsvp-van-item.active {
    border-color: var(--color-primary);
    background: rgba(var(--color-primary-rgb), 0.1);
  }
  .rsvp-van-item input[type="radio"] {
    width: 14px;
    height: 14px;
    accent-color: var(--color-primary);
    margin: 0;
  }

  /* Add Button */
  .rsvp-add-btn {
    width: 100%;
    padding: 1rem;
    border: 2px dashed var(--color-border);
    border-radius: 12px;
    background: transparent;
    cursor: pointer;
    font-size: 0.95rem;
    color: var(--color-input-placeholder);
    margin-bottom: 1.5rem;
    transition: all 0.2s;
  }
  .rsvp-add-btn:hover {
    border-color: var(--color-primary);
    color: var(--color-primary);
  }

  /* Submit */
  .rsvp-submit-btn {
    width: 100%;
    padding: 1rem 2rem;
    background: var(--color-primary);
    color: var(--color-white);
    border: none;
    border-radius: 8px;
    font-size: 1rem;
    font-weight: 600;
    cursor: pointer;
    transition: background 0.2s;
  }
  .rsvp-submit-btn:hover {
    background: var(--color-primary-dark);
  }
  .rsvp-submit-btn:disabled {
    opacity: 0.6;
    cursor: not-allowed;
  }

  /* Message */
  .rsvp-message {
    margin-bottom: 1rem;
    border-radius: 8px;
    text-align: center;
    font-weight: 500;
  }
  .rsvp-message.success {
    padding: 1rem;
    background: var(--color-success-bg);
    border: 1px solid var(--color-success);
    color: var(--color-success-dark);
  }
  .rsvp-message.error {
    padding: 1rem;
    background: var(--color-error-bg);
    border: 1px solid var(--color-error);
    color: var(--color-error-dark);
  }

  /* Modal */
  .rsvp-modal {
    display: none;
    position: fixed;
    inset: 0;
    z-index: 1000;
    align-items: center;
    justify-content: center;
    padding: 1rem;
  }
  .rsvp-modal.open {
    display: flex;
  }
  .rsvp-modal-overlay {
    position: absolute;
    inset: 0;
    background: var(--color-overlay);
  }
  .rsvp-modal-box {
    position: relative;
    background: var(--color-background);
    border-radius: 12px;
    padding: 2rem;
    max-width: 400px;
    width: 100%;
    box-shadow: 0 10px 40px var(--color-shadow-lg);
  }
  .rsvp-modal-close {
    position: absolute;
    top: 1rem;
    right: 1rem;
    width: 32px;
    height: 32px;
    border: none;
    background: var(--color-input-disabled);
    border-radius: 50%;
    font-size: 1.5rem;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--color-text-light);
  }
  .rsvp-modal-close:hover {
    background: var(--color-danger);
    color: var(--color-white);
  }
  .rsvp-modal-title {
    margin: 0 0 0.5rem;
    font-size: 1.25rem;
    color: var(--color-text);
  }
  .rsvp-modal-text {
    margin: 0 0 1rem;
    color: var(--color-text-light);
  }
  .rsvp-modal-input {
    width: 100%;
    padding: 0.75rem;
    border: 2px solid var(--color-input-border);
    border-radius: 8px;
    font-size: 1rem;
    margin-bottom: 1rem;
    font-family: inherit;
    box-sizing: border-box;
  }
  .rsvp-modal-input:focus {
    outline: none;
    border-color: var(--color-primary);
  }
  .rsvp-modal-btn {
    width: 100%;
    padding: 0.75rem;
    background: var(--color-primary);
    color: var(--color-white);
    border: none;
    border-radius: 8px;
    font-size: 1rem;
    cursor: pointer;
  }
  .rsvp-modal-btn:hover {
    background: var(--color-primary-dark);
  }
  .rsvp-modal-btn:disabled {
    opacity: 0.6;
  }
  .rsvp-modal-error {
    color: var(--color-error-dark);
    font-size: 0.875rem;
    margin: 0.5rem 0 0;
  }
  .rsvp-modal-error:empty {
    display: none;
  }

  /* RSVP Overlay */
  .rsvp-overlay {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    z-index: 100;
    display: flex;
    align-items: center;
    justify-content: center;
    background: rgba(255, 255, 255, 0.7);
    backdrop-filter: blur(2px);
  }

  .rsvp-overlay-content {
    max-width: 500px;
    padding: var(--spacing-8);
    text-align: center;
    background: var(--color-background);
    border-radius: 16px;
    box-shadow: 0 10px 40px var(--color-shadow-lg);
    margin: 1rem;
  }

  .rsvp-overlay-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 80px;
    height: 80px;
    margin: 0 auto var(--spacing-6);
    background: var(--color-accent-light);
    border-radius: 50%;
  }

  .rsvp-overlay-icon svg {
    width: 40px;
    height: 40px;
    color: var(--color-accent);
  }

  .rsvp-overlay-title {
    font-family: var(--font-script);
    font-size: var(--font-size-3xl);
    color: var(--color-accent);
    margin-bottom: var(--spacing-4);
  }

  .rsvp-overlay-text {
    font-size: var(--font-size-lg);
    color: var(--color-text-light);
    line-height: var(--line-height-relaxed);
    margin-bottom: 0;
  }

  /* Responsive */
  @media (max-width: 600px) {
    .rsvp-row {
      flex-direction: column;
      align-items: flex-start;
      gap: 0.5rem;
      padding: 0.875rem 1.25rem;
    }
    .rsvp-row-label {
      width: auto;
    }
    .rsvp-row-content {
      width: 100%;
    }
    .rsvp-attendance {
      width: 100%;
    }
    .rsvp-attendance-btn {
      flex: 1;
      justify-content: center;
    }
    .rsvp-allergy {
      flex-direction: column;
      align-items: flex-start;
      gap: 0.4rem;
    }
    .rsvp-allergy-input {
      width: 100%;
    }
  }
</style>

<script>
  import { getAuthState, getApiUrl } from '@/scripts/auth';

  interface Guest {
    code: string;
    name: string;
    attending: string;
    dietary: string[];
    allergyDetails: string;
    van: string;
    isConfirmed: boolean;
  }

  const API_URL = getApiUrl();
  let guests: Guest[] = [];

  function init() {
    guests = [];
    loadCurrentUser();
    setupEventListeners();
  }

  function setupEventListeners() {
    document.getElementById('addGuestBtn')?.addEventListener('click', openModal);
    document.getElementById('closeModalBtn')?.addEventListener('click', closeModal);
    document.querySelector('.rsvp-modal-overlay')?.addEventListener('click', closeModal);
    document.getElementById('validateBtn')?.addEventListener('click', validateCode);
    document.getElementById('modalCodeInput')?.addEventListener('keypress', (e) => {
      if ((e as KeyboardEvent).key === 'Enter') validateCode();
    });
    document.getElementById('rsvpForm')?.addEventListener('submit', handleSubmit);
  }

  async function loadCurrentUser() {
    const { guestCode } = getAuthState();
    if (!guestCode) {
      hideLoading();
      return;
    }

    const rsvpData = await fetchRSVP(guestCode);

    // Load all previously confirmed guests
    if (rsvpData.length > 0) {
      rsvpData.forEach((r: any) => {
        const { dietary, allergyDetails } = parseDietary(r.dietary || '');
        guests.push({
          code: r.guestCode,
          name: r.guestName || '',
          attending: r.attending || '',
          dietary,
          allergyDetails,
          van: r.van || '',
          isConfirmed: true
        });
      });
    }

    // If current user wasn't in the RSVP data, fetch their info and add as pending
    const currentUserExists = guests.some(g => g.code === guestCode);
    if (!currentUserExists) {
      const guestInfo = await fetchGuestInfo(guestCode);
      guests.push({
        code: guestCode,
        name: guestInfo?.name || '',
        attending: '',
        dietary: [],
        allergyDetails: '',
        van: '',
        isConfirmed: false
      });
    }

    hideLoading();
    render();
  }

  function hideLoading() {
    const loading = document.getElementById('rsvpLoading');
    const form = document.getElementById('rsvpForm');
    if (loading) loading.style.display = 'none';
    if (form) form.style.display = 'block';
  }

  async function fetchGuestInfo(code: string): Promise<{ name: string } | null> {
    try {
      const res = await fetch(`${API_URL}?action=getGuest&code=${encodeURIComponent(code)}`);
      const data = await res.json();
      return data.success && data.guest ? { name: data.guest.name } : null;
    } catch {
      return null;
    }
  }

  async function fetchRSVP(code: string): Promise<any[]> {
    try {
      const res = await fetch(`${API_URL}?action=getRSVP&code=${encodeURIComponent(code)}`);
      const data = await res.json();
      return data.success ? data.responses : [];
    } catch {
      return [];
    }
  }

  function parseDietary(str: string): { dietary: string[], allergyDetails: string } {
    if (!str) return { dietary: [], allergyDetails: '' };
    const parts = str.split(', ');
    const dietary: string[] = [];
    let allergyDetails = '';
    parts.forEach(part => {
      if (part.startsWith('Alérgico:')) {
        dietary.push('Alérgico');
        allergyDetails = part.replace('Alérgico:', '').trim();
      } else if (part === 'Alérgico') {
        dietary.push('Alérgico');
      } else if (part) {
        dietary.push(part);
      }
    });
    return { dietary, allergyDetails };
  }

  function getStatus(guest: Guest): { css: string, text: string } {
    if (!guest.isConfirmed) return { css: 'pending', text: 'Pendente' };
    if (guest.attending === 'Sim') return { css: 'confirmed', text: 'Confirmado' };
    return { css: 'not-going', text: 'Não irá' };
  }

  function saveFormState() {
    const container = document.getElementById('guestsList');
    if (!container) return;

    guests.forEach((guest, i) => {
      const nameInput = container.querySelector(`[name="name-${i}"]`) as HTMLInputElement;
      const attendingInput = container.querySelector(`[name="attending-${i}"]`) as HTMLInputElement;
      const dietaryInputs = container.querySelectorAll(`[name="dietary-${i}"]:checked`) as NodeListOf<HTMLInputElement>;
      const allergyInput = container.querySelector(`[name="allergy-${i}"]`) as HTMLInputElement;
      const vanInput = container.querySelector(`[name="van-${i}"]:checked`) as HTMLInputElement;

      if (nameInput) guest.name = nameInput.value;
      if (attendingInput) guest.attending = attendingInput.value;
      guest.van = vanInput?.value || '';

      // Save dietary selections
      const dietaryArr: string[] = [];
      dietaryInputs.forEach(cb => {
        if (cb.value !== 'Alérgico') {
          dietaryArr.push(cb.value);
        }
      });

      // Check if Alérgico is selected
      const allergyCheckbox = container.querySelector(`[name="dietary-${i}"][value="Alérgico"]`) as HTMLInputElement;
      if (allergyCheckbox?.checked) {
        dietaryArr.push('Alérgico');
        guest.allergyDetails = allergyInput?.value || '';
      } else {
        guest.allergyDetails = '';
      }

      guest.dietary = dietaryArr;
    });
  }

  function render() {
    const container = document.getElementById('guestsList');
    if (!container) return;

    container.innerHTML = guests.map((guest, i) => {
      const status = getStatus(guest);
      const hasAllergy = guest.dietary.includes('Alérgico');

      return `
        <div class="rsvp-card">
          ${i > 0 ? `<button type="button" class="rsvp-card-remove" data-idx="${i}">&times;</button>` : ''}

          <div class="rsvp-row">
            <span class="rsvp-row-label">Código</span>
            <div class="rsvp-row-content">
              <div class="rsvp-code-display">
                <span class="rsvp-code-text">${guest.code}</span>
                <span class="rsvp-status ${status.css}">${status.text}</span>
              </div>
            </div>
          </div>

          <div class="rsvp-row">
            <span class="rsvp-row-label">Nome</span>
            <div class="rsvp-row-content">
              <input type="text" class="rsvp-name-input" name="name-${i}" value="${guest.name}" placeholder="Nome completo" required />
            </div>
          </div>

          <div class="rsvp-row">
            <span class="rsvp-row-label">Vai comparecer?</span>
            <div class="rsvp-row-content">
              <div class="rsvp-attendance">
                <button type="button" class="rsvp-attendance-btn yes ${guest.attending === 'Sim' ? 'active' : ''}" data-idx="${i}" data-val="Sim">&#10003; Sim</button>
                <button type="button" class="rsvp-attendance-btn no ${guest.attending === 'Não' ? 'active' : ''}" data-idx="${i}" data-val="Não">&#10007; Não</button>
              </div>
              <input type="hidden" name="attending-${i}" value="${guest.attending}" />
            </div>
          </div>

          <div class="rsvp-row">
            <span class="rsvp-row-label">Restrições</span>
            <div class="rsvp-row-content">
              <div class="rsvp-dietary">
                <label class="rsvp-dietary-item ${guest.dietary.includes('Vegetariano') ? 'active' : ''}">
                  <input type="checkbox" name="dietary-${i}" value="Vegetariano" ${guest.dietary.includes('Vegetariano') ? 'checked' : ''} />
                  Vegetariano
                </label>
                <label class="rsvp-dietary-item ${guest.dietary.includes('Diabetico') ? 'active' : ''}">
                  <input type="checkbox" name="dietary-${i}" value="Diabetico" ${guest.dietary.includes('Diabetico') ? 'checked' : ''} />
                  Diabetico
                </label>
                <label class="rsvp-dietary-item ${guest.dietary.includes('Alérgico') ? 'active' : ''}">
                  <input type="checkbox" class="allergy-check" name="dietary-${i}" value="Alérgico" data-idx="${i}" ${hasAllergy ? 'checked' : ''} />
                  Alérgico
                </label>
              </div>
              <div class="rsvp-allergy ${hasAllergy ? 'show' : ''}" data-allergy-row="${i}">
                <span class="rsvp-allergy-label">A que?</span>
                <input type="text" class="rsvp-allergy-input" name="allergy-${i}" value="${guest.allergyDetails}" placeholder="Ex: amendoim, camarao..." />
              </div>
            </div>
          </div>

          <div class="rsvp-row">
            <span class="rsvp-row-label">Precisa de van?</span>
            <div class="rsvp-row-content">
              <div class="rsvp-van">
                <label class="rsvp-van-item ${guest.van === '' ? 'active' : ''}">
                  <input type="radio" name="van-${i}" value="" ${guest.van === '' ? 'checked' : ''} />
                  Não preciso
                </label>
                <label class="rsvp-van-item ${guest.van === 'Osasco' ? 'active' : ''}">
                  <input type="radio" name="van-${i}" value="Osasco" ${guest.van === 'Osasco' ? 'checked' : ''} />
                  Osasco
                </label>
                <label class="rsvp-van-item ${guest.van === 'Moema' ? 'active' : ''}">
                  <input type="radio" name="van-${i}" value="Moema" ${guest.van === 'Moema' ? 'checked' : ''} />
                  Moema
                </label>
                <label class="rsvp-van-item ${guest.van === 'São Caetano' ? 'active' : ''}">
                  <input type="radio" name="van-${i}" value="São Caetano" ${guest.van === 'São Caetano' ? 'checked' : ''} />
                  São Caetano
                </label>
              </div>
            </div>
          </div>
        </div>
      `;
    }).join('');

    // Remove buttons
    container.querySelectorAll('.rsvp-card-remove').forEach(btn => {
      btn.addEventListener('click', (e) => {
        saveFormState();
        const idx = parseInt((e.currentTarget as HTMLElement).dataset.idx || '0');
        guests.splice(idx, 1);
        render();
      });
    });

    // Attendance buttons
    container.querySelectorAll('.rsvp-attendance-btn').forEach(btn => {
      btn.addEventListener('click', (e) => {
        const el = e.currentTarget as HTMLElement;
        const idx = parseInt(el.dataset.idx || '0');
        const val = el.dataset.val || '';
        guests[idx].attending = val;
        const hidden = container.querySelector(`[name="attending-${idx}"]`) as HTMLInputElement;
        if (hidden) hidden.value = val;
        const row = el.closest('.rsvp-attendance');
        row?.querySelectorAll('.rsvp-attendance-btn').forEach(b => b.classList.remove('active'));
        el.classList.add('active');
      });
    });

    // Allergy checkbox
    container.querySelectorAll('.allergy-check').forEach(cb => {
      cb.addEventListener('change', (e) => {
        const el = e.target as HTMLInputElement;
        const idx = el.dataset.idx;
        const allergyRow = container.querySelector(`[data-allergy-row="${idx}"]`);
        const label = el.closest('.rsvp-dietary-item');
        if (el.checked) {
          allergyRow?.classList.add('show');
          label?.classList.add('active');
        } else {
          allergyRow?.classList.remove('show');
          label?.classList.remove('active');
          const input = allergyRow?.querySelector('input') as HTMLInputElement;
          if (input) input.value = '';
        }
      });
    });

    // Dietary checkboxes styling
    container.querySelectorAll('.rsvp-dietary-item input:not(.allergy-check)').forEach(cb => {
      cb.addEventListener('change', (e) => {
        const el = e.target as HTMLInputElement;
        const label = el.closest('.rsvp-dietary-item');
        el.checked ? label?.classList.add('active') : label?.classList.remove('active');
      });
    });

    // Van radio buttons styling
    container.querySelectorAll('.rsvp-van-item input[type="radio"]').forEach(radio => {
      radio.addEventListener('change', (e) => {
        const el = e.target as HTMLInputElement;
        const vanGroup = el.closest('.rsvp-van');
        vanGroup?.querySelectorAll('.rsvp-van-item').forEach(item => item.classList.remove('active'));
        el.closest('.rsvp-van-item')?.classList.add('active');
      });
    });
  }

  function openModal() {
    document.getElementById('modal')?.classList.add('open');
    (document.getElementById('modalCodeInput') as HTMLInputElement)?.focus();
  }

  function closeModal() {
    document.getElementById('modal')?.classList.remove('open');
    (document.getElementById('modalCodeInput') as HTMLInputElement).value = '';
    (document.getElementById('modalError') as HTMLElement).textContent = '';
  }

  async function validateCode() {
    const input = document.getElementById('modalCodeInput') as HTMLInputElement;
    const errorEl = document.getElementById('modalError') as HTMLElement;
    const btn = document.getElementById('validateBtn') as HTMLButtonElement;
    const code = input.value.trim();

    if (!code) { errorEl.textContent = 'Digite um código.'; return; }
    if (guests.some(g => g.code.toLowerCase() === code.toLowerCase())) {
      errorEl.textContent = 'Convidado já adicionado.'; return;
    }

    btn.disabled = true;
    btn.textContent = 'Validando...';

    try {
      const res = await fetch(`${API_URL}?action=login&code=${encodeURIComponent(code)}`);
      const data = await res.json();
      if (!data.success) { errorEl.textContent = 'Código inválido.'; return; }

      const { guestCode } = getAuthState();
      const rsvpData = await fetchRSVP(guestCode!);
      const existing = rsvpData.find((r: any) => r.guestCode === data.guest.code);
      const { dietary, allergyDetails } = parseDietary(existing?.dietary || '');

      // Save current form state before adding new guest
      saveFormState();

      guests.push({
        code: data.guest.code,
        name: existing?.guestName || data.guest.name || '',
        attending: existing?.attending || '',
        dietary,
        allergyDetails,
        van: existing?.van || '',
        isConfirmed: !!existing
      });

      render();
      closeModal();
    } catch {
      errorEl.textContent = 'Erro ao validar.';
    } finally {
      btn.disabled = false;
      btn.textContent = 'Validar';
    }
  }

  async function handleSubmit(e: Event) {
    e.preventDefault();
    const form = e.target as HTMLFormElement;
    const submitBtn = document.getElementById('submitBtn') as HTMLButtonElement;
    const messageEl = document.getElementById('formMessage') as HTMLElement;

    const guestsData = guests.map((guest, i) => {
      const nameInput = form.querySelector(`[name="name-${i}"]`) as HTMLInputElement;
      const attendingInput = form.querySelector(`[name="attending-${i}"]`) as HTMLInputElement;
      const dietaryInputs = form.querySelectorAll(`[name="dietary-${i}"]:checked`) as NodeListOf<HTMLInputElement>;
      const allergyInput = form.querySelector(`[name="allergy-${i}"]`) as HTMLInputElement;
      const vanInput = form.querySelector(`[name="van-${i}"]:checked`) as HTMLInputElement;

      const dietaryArr = Array.from(dietaryInputs).map(cb => {
        if (cb.value === 'Alérgico' && allergyInput?.value.trim()) {
          return `Alérgico: ${allergyInput.value.trim()}`;
        }
        return cb.value;
      });

      return {
        code: guest.code,
        name: nameInput?.value.trim() || '',
        attending: attendingInput?.value || '',
        dietary: dietaryArr.join(', '),
        van: vanInput?.value || ''
      };
    });

    if (guestsData.some(g => !g.attending)) {
      messageEl.textContent = 'Selecione se cada convidado vai comparecer.';
      messageEl.className = 'rsvp-message error';
      return;
    }
    if (guestsData.some(g => !g.name)) {
      messageEl.textContent = 'Preencha o nome de todos os convidados.';
      messageEl.className = 'rsvp-message error';
      return;
    }

    submitBtn.disabled = true;
    submitBtn.textContent = 'Enviando...';
    messageEl.textContent = '';
    messageEl.className = 'rsvp-message';

    try {
      const { guestCode } = getAuthState();
      const res = await fetch(API_URL, {
        method: 'POST',
        headers: { 'Content-Type': 'text/plain' },
        body: JSON.stringify({ action: 'submitRSVP', confirmedBy: guestCode, guests: guestsData })
      });
      const result = await res.json();

      if (result.success) {
        messageEl.textContent = 'Presença confirmada com sucesso!';
        messageEl.className = 'rsvp-message success';
        guests.forEach((g, i) => {
          g.isConfirmed = true;
          g.name = guestsData[i].name;
          g.attending = guestsData[i].attending;
          g.van = guestsData[i].van;
          const parsed = parseDietary(guestsData[i].dietary);
          g.dietary = parsed.dietary;
          g.allergyDetails = parsed.allergyDetails;
        });
        render();
      } else {
        messageEl.textContent = 'Erro ao confirmar. Tente novamente.';
        messageEl.className = 'rsvp-message error';
      }
    } catch {
      messageEl.textContent = 'Erro de conexão. Tente novamente.';
      messageEl.className = 'rsvp-message error';
    } finally {
      submitBtn.disabled = false;
      submitBtn.textContent = 'Confirmar Presença';
    }
  }

  document.addEventListener('DOMContentLoaded', init);
  document.addEventListener('astro:page-load', init);
</script>
