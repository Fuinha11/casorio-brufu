---
import ProtectedLayout from '@/layouts/ProtectedLayout.astro';
import Countdown from '@/components/Countdown.astro';
import HeroDecoration from '@/components/HeroDecoration.astro';

// Wedding date: April 10, 2026 at 8:00 PM (20:00) Brazil time
const weddingDate = '2026-04-10T20:00:00-03:00';
const basePath = import.meta.env.BASE_URL || '';
---

<ProtectedLayout title="Início">
  <!-- Hero Section -->
  <section class="hero">
    <div class="hero-overlay"></div>
    <div class="hero-content">
      <div class="hero-text animate-fade-in-down">
        <p class="hero-subtitle">Você está convidado para o casamento de</p>
        <h1 class="hero-title script-font">Bruna & Marcos</h1>
        <p class="hero-date">10 de Abril de 2026</p>
        <p class="hero-venue">Botânico Quintal | São Paulo</p>
      </div>

      <div class="hero-countdown animate-fade-in-up">
        <Countdown targetDate={weddingDate} />
      </div>

      <a href="#welcome" class="hero-scroll-btn animate-fade-in">
        <span class="scroll-text">Saiba mais</span>
        <svg class="scroll-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M12 5v14M5 12l7 7 7-7"></path>
        </svg>
      </a>
    </div>

    <!-- Decorative Logos -->
    <HeroDecoration variant="dark" />
  </section>

  <!-- Welcome Section -->
  <section id="welcome" class="section welcome-section">
    <div class="container container-narrow text-center">
      <p class="section-subtitle">Celebre conosco</p>
      <h2 class="section-title">Bem-vindo(a)!</h2>

      <div class="welcome-content">
        <p class="welcome-text">
          É com grande alegria que convidamos você para celebrar conosco
          este momento tão especial em nossas vidas.
        </p>
        <p class="welcome-text">
          Após anos de muito amor, companheirismo e histórias compartilhadas,
          decidimos unir nossas vidas em matrimônio. Seria uma honra ter você
          presente neste dia memorável.
        </p>
        <p class="welcome-text">
          Navegue pelo site para conhecer mais sobre nossa história, detalhes
          do evento e confirmar sua presença.
        </p>
      </div>

      <div class="welcome-decoration">
        <div class="decoration-line"></div>
        <span class="decoration-heart">&hearts;</span>
        <div class="decoration-line"></div>
      </div>
    </div>
  </section>

  <!-- Quick Links Section -->
  <section class="section section-alt quick-links-section">
    <div class="container">
      <div class="quick-links-grid">
        <a href={`${basePath}/nossa-historia`} class="quick-link-card">
          <div class="quick-link-icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
              <path d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z"></path>
            </svg>
          </div>
          <h3 class="quick-link-title">Nossa História</h3>
          <p class="quick-link-text">Conheça a nossa jornada até aqui</p>
        </a>

        <a href={`${basePath}/evento`} class="quick-link-card">
          <div class="quick-link-icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
              <path d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"></path>
            </svg>
          </div>
          <h3 class="quick-link-title">O Evento</h3>
          <p class="quick-link-text">Data, horário e local da cerimônia</p>
        </a>

        <a href={`${basePath}/confirmar-presenca`} class="quick-link-card">
          <div class="quick-link-icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
              <path d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path>
            </svg>
          </div>
          <h3 class="quick-link-title">Confirmar Presença</h3>
          <p class="quick-link-text">Confirme sua presença no evento</p>
        </a>

        <a href={`${basePath}/presentes`} class="quick-link-card">
          <div class="quick-link-icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
              <path d="M12 8v13m0-13V6a2 2 0 112 2h-2zm0 0V5.5A2.5 2.5 0 109.5 8H12zm-7 4h14M5 12a2 2 0 110-4h14a2 2 0 110 4M5 12v7a2 2 0 002 2h10a2 2 0 002-2v-7"></path>
            </svg>
          </div>
          <h3 class="quick-link-title">Lista de Presentes</h3>
          <p class="quick-link-text">Veja nossas sugestões de presentes</p>
        </a>
      </div>
    </div>
  </section>
</ProtectedLayout>

<style>
  /* Hero Section */
  .hero {
    position: relative;
    min-height: 100vh;
    display: flex;
    align-items: center;
    justify-content: center;
    background: linear-gradient(135deg, var(--color-primary) 0%, var(--color-primary-dark) 100%);
    overflow: hidden;
    padding: var(--spacing-6);
  }

  /* Custom hero decorations - twice as big, one high one low */
  .hero :global(.hero-deco) {
    height: 400px;
  }

  .hero :global(.hero-deco-left) {
    top: 10%;
    transform: translateY(0);
  }

  .hero :global(.hero-deco-right) {
    top: auto;
    bottom: 10%;
    transform: translateY(0);
  }

  @keyframes floatLeftHome {
    0%, 100% { transform: translateY(0) rotate(-5deg); }
    50% { transform: translateY(-30px) rotate(5deg); }
  }

  @keyframes floatRightHome {
    0%, 100% { transform: translateY(0) rotate(5deg); }
    50% { transform: translateY(30px) rotate(-3deg); }
  }

  .hero :global(.hero-deco-left) {
    animation: floatLeftHome 8s ease-in-out infinite;
  }

  .hero :global(.hero-deco-right) {
    animation: floatRightHome 8s ease-in-out infinite;
  }

  .hero-overlay {
    position: absolute;
    inset: 0;
    background: url('data:image/svg+xml,<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 100 100"><circle cx="50" cy="50" r="1" fill="rgba(255,255,255,0.1)"/></svg>');
    background-size: 20px 20px;
    opacity: 0.5;
  }

  .hero-content {
    position: relative;
    z-index: 1;
    text-align: center;
    max-width: 800px;
  }

  .hero-text {
    margin-bottom: var(--spacing-12);
  }

  .hero-subtitle {
    font-size: var(--font-size-lg);
    color: rgba(255, 255, 255, 0.9);
    letter-spacing: var(--letter-spacing-wide);
    margin-bottom: var(--spacing-4);
    text-transform: uppercase;
  }

  .hero-title {
    font-family: var(--font-script);
    font-size: var(--font-size-hero);
    color: var(--color-text-inverse);
    margin-bottom: var(--spacing-4);
    text-shadow: 2px 4px 8px rgba(0, 0, 0, 0.2);
  }

  .hero-date {
    font-family: var(--font-heading);
    font-size: var(--font-size-2xl);
    color: var(--color-accent-light);
    letter-spacing: var(--letter-spacing-wider);
    margin-bottom: var(--spacing-2);
  }

  .hero-venue {
    font-size: var(--font-size-md);
    color: rgba(255, 255, 255, 0.8);
    margin-bottom: 0;
  }

  .hero-countdown {
    margin-bottom: var(--spacing-12);
  }

  .hero-scroll-btn {
    display: inline-flex;
    flex-direction: column;
    align-items: center;
    gap: var(--spacing-2);
    color: rgba(255, 255, 255, 0.8);
    text-decoration: none;
    transition: all var(--transition-normal);
  }

  .hero-scroll-btn:hover {
    color: var(--color-text-inverse);
    transform: translateY(4px);
  }

  .scroll-text {
    font-size: var(--font-size-sm);
    letter-spacing: var(--letter-spacing-wide);
    text-transform: uppercase;
  }

  .scroll-icon {
    width: 24px;
    height: 24px;
    animation: bounce 2s ease-in-out 3;
  }

  @keyframes bounce {
    0%, 100% { transform: translateY(0); }
    50% { transform: translateY(8px); }
  }

  /* Welcome Section */
  .welcome-section {
    background-color: var(--color-background);
  }

  .welcome-content {
    margin-bottom: var(--spacing-8);
  }

  .welcome-text {
    font-size: var(--font-size-lg);
    color: var(--color-text-light);
    line-height: var(--line-height-relaxed);
    max-width: 600px;
    margin-left: auto;
    margin-right: auto;
  }

  .welcome-decoration {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: var(--spacing-4);
  }

  .decoration-line {
    width: 100px;
    height: 1px;
    background: linear-gradient(to right, transparent, var(--color-accent), transparent);
  }

  .decoration-heart {
    color: var(--color-accent);
    font-size: var(--font-size-xl);
  }

  /* Quick Links Section */
  .quick-links-section {
    padding-top: var(--spacing-16);
    padding-bottom: var(--spacing-16);
  }

  .quick-links-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
    gap: var(--spacing-6);
  }

  .quick-link-card {
    display: flex;
    flex-direction: column;
    align-items: center;
    padding: var(--spacing-8);
    background-color: var(--color-background);
    border-radius: var(--radius-xl);
    text-decoration: none;
    text-align: center;
    box-shadow: var(--shadow-md);
    transition: all var(--transition-normal);
  }

  .quick-link-card:hover {
    transform: translateY(-8px);
    box-shadow: var(--shadow-xl);
  }

  .quick-link-icon {
    width: 60px;
    height: 60px;
    display: flex;
    align-items: center;
    justify-content: center;
    background-color: var(--color-secondary);
    border-radius: var(--radius-full);
    margin-bottom: var(--spacing-4);
    transition: all var(--transition-normal);
  }

  .quick-link-icon svg {
    width: 28px;
    height: 28px;
    color: var(--color-primary);
  }

  .quick-link-card:hover .quick-link-icon {
    background-color: var(--color-primary);
  }

  .quick-link-card:hover .quick-link-icon svg {
    color: var(--color-text-inverse);
  }

  .quick-link-title {
    font-family: var(--font-heading);
    font-size: var(--font-size-xl);
    color: var(--color-text);
    margin-bottom: var(--spacing-2);
  }

  .quick-link-text {
    font-size: var(--font-size-sm);
    color: var(--color-text-light);
    margin-bottom: 0;
  }

  /* Responsive */
  @media (max-width: 768px) {
    .hero {
      padding-top: var(--spacing-16);
    }

    .hero-subtitle {
      font-size: var(--font-size-base);
    }

    .hero-title {
      font-size: var(--font-size-4xl);
    }

    .hero-date {
      font-size: var(--font-size-xl);
    }

    .hero :global(.hero-deco) {
      height: 200px;
    }

    .hero :global(.hero-deco-left) {
      top: 5%;
      left: 10px;
    }

    .hero :global(.hero-deco-right) {
      bottom: 5%;
      right: 10px;
    }

    .quick-links-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
