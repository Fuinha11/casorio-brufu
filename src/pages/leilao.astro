---
import ProtectedLayout from '@/layouts/ProtectedLayout.astro';
import HeroDecoration from '@/components/HeroDecoration.astro';

const auctionItems = [
  {
    id: 'primeira-musica',
    name: 'Primeira Música',
    description: 'Escolha a primeira música que tocará na festa! O vencedor terá a honra de dar início à pista de dança.',
    minBid: 100,
    increment: 10,
    icon: '🎵'
  },
  {
    id: 'brinde-noivos',
    name: 'Brinde dos Noivos',
    description: 'Faça o brinde oficial da noite! Levante sua taça e diga algumas palavras para os noivos.',
    minBid: 150,
    increment: 25,
    icon: '🥂'
  },
  {
    id: 'danca-especial',
    name: 'Dança Especial',
    description: 'Ganhe uma dança exclusiva com a noiva ou o noivo durante a festa.',
    minBid: 200,
    increment: 25,
    icon: '💃'
  },
  {
    id: 'primeira-foto',
    name: 'Primeira Foto',
    description: 'Seja a primeira pessoa a tirar uma foto oficial com os recém-casados.',
    minBid: 100,
    increment: 10,
    icon: '📸'
  },
  {
    id: 'karaoke',
    name: 'Escolha do Karaokê',
    description: 'Escolha uma música para cantar no karaokê (e convoque quem quiser para cantar junto!)',
    minBid: 80,
    increment: 10,
    icon: '🎤'
  },
  {
    id: 'cubos-acucar',
    name: 'Primeira Colherada do Carrinho',
    description: 'Privilégio VIP de dar a primeira colherada no carrinho da @cubosdeacucar!',
    minBid: 5,
    increment: 2,
    icon: '🥄'
  },
];

const auctionItemsJson = JSON.stringify(auctionItems);
---

<ProtectedLayout title="Leilão">
  <!-- Coming Soon Overlay - Remove this div when ready to accept bids -->
  <div class="coming-soon-overlay">
    <div class="coming-soon-content">
      <div class="coming-soon-icon">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
          <path d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path>
        </svg>
      </div>
      <h2 class="coming-soon-title">Em Breve</h2>
      <p class="coming-soon-text">
        Estamos preparando um leilão super divertido com experiências únicas
        para vocês participarem! Fiquem ligados, em breve abriremos os lances.
      </p>
    </div>
  </div>
  <!-- End Coming Soon Overlay -->

  <section class="page-hero">
    <HeroDecoration variant="dark" />
    <div class="container text-center">
      <p class="section-subtitle">Diversão</p>
      <h1 class="page-title">Leilão Beneficente</h1>
    </div>
  </section>

  <section class="section auction-section">
    <div class="container">
      <div class="auction-intro text-center">
        <p class="auction-intro-text">
          Participe do nosso leilão divertido! Os valores arrecadados serão
          destinados à nossa lua de mel. Faça seus lances e garanta experiências
          únicas no nosso casamento!
        </p>
        <p class="auction-update-note">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path>
          </svg>
          Os lances sao atualizados a cada poucos minutos
        </p>
      </div>

      <div class="auction-grid">
        {auctionItems.map((item) => (
          <div class="auction-card" data-auction={item.id}>
            <div class="auction-icon">{item.icon}</div>
            <h3 class="auction-title">{item.name}</h3>
            <p class="auction-description">{item.description}</p>

            <div class="auction-status">
              <div class="auction-current">
                <span class="auction-label">Lance atual</span>
                <span class="auction-value bid">Carregando...</span>
              </div>
              <div class="auction-leader">
                <span class="auction-label">Lider</span>
                <span class="auction-value winner">Carregando...</span>
              </div>
            </div>

            <p class="auction-min">Lance mínimo: R$ {item.minBid}</p>

            <button
              type="button"
              class="btn btn-accent auction-bid-btn"
              data-item-id={item.id}
              data-item-name={item.name}
              data-min-bid={item.minBid}
              data-increment={item.increment}
            >
              Fazer Lance
            </button>
          </div>
        ))}
      </div>

      <!-- Bid Modal -->
      <div id="bidModal" class="bid-modal">
        <div class="bid-modal-backdrop"></div>
        <div class="bid-modal-content">
          <button type="button" class="bid-modal-close" id="closeModal">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M6 18L18 6M6 6l12 12"></path>
            </svg>
          </button>

          <div class="bid-modal-header">
            <span class="bid-modal-icon" id="modalIcon"></span>
            <h3 class="bid-modal-title" id="modalTitle">Fazer Lance</h3>
          </div>

          <form id="bidForm" class="bid-form">
            <input type="hidden" id="guestCode" name="guestCode" />
            <input type="hidden" id="guestName" name="guestName" />
            <input type="hidden" id="itemId" name="itemId" />
            <input type="hidden" id="itemName" name="itemName" />

            <div class="bid-form-info">
              <div class="bid-info-row">
                <span class="bid-info-label">Lance atual:</span>
                <span class="bid-info-value" id="modalCurrentBid">R$ 0</span>
              </div>
              <div class="bid-info-row">
                <span class="bid-info-label">Lider:</span>
                <span class="bid-info-value" id="modalCurrentWinner">Nenhum</span>
              </div>
            </div>

            <div class="bid-form-group">
              <label for="bidAmount" class="bid-form-label">Seu lance (R$)</label>
              <div class="bid-amount-control">
                <button type="button" class="bid-amount-btn bid-decrement" id="bidDecrement">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3">
                    <path d="M5 12h14"></path>
                  </svg>
                </button>
                <input
                  type="number"
                  id="bidAmount"
                  name="bidAmount"
                  class="bid-form-input"
                  placeholder="0"
                  min="1"
                  step="1"
                  readonly
                  required
                />
                <button type="button" class="bid-amount-btn bid-increment" id="bidIncrement">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3">
                    <path d="M12 5v14M5 12h14"></path>
                  </svg>
                </button>
              </div>
              <span class="bid-form-hint" id="minBidHint">Lance mínimo: R$ 100</span>
            </div>

            <div id="bidMessage" class="bid-message"></div>

            <div class="bid-form-actions">
              <button type="button" class="btn btn-secondary" id="cancelBid">Cancelar</button>
              <button type="submit" class="btn btn-accent" id="submitBid">Confirmar Lance</button>
            </div>
          </form>
        </div>
      </div>

      <div class="auction-rules">
        <h3 class="auction-rules-title">Como funciona</h3>
        <ol class="auction-rules-list">
          <li>Escolha o item que deseja arrematar</li>
          <li>Clique em "Fazer Lance" e preencha o formulario</li>
          <li>Seu lance deve ser maior que o lance atual</li>
          <li>O vencedor sera anunciado no dia do casamento</li>
          <li>O pagamento sera feito diretamente aos noivos</li>
        </ol>
      </div>
    </div>
  </section>
</ProtectedLayout>

<style>
  /* Coming Soon Overlay - Remove these styles when ready */
  .coming-soon-overlay {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    z-index: 100;
    display: flex;
    align-items: center;
    justify-content: center;
    background: rgba(255, 255, 255, 0.7);
    backdrop-filter: blur(2px);
  }

  .coming-soon-content {
    max-width: 500px;
    padding: var(--spacing-8);
    text-align: center;
  }

  .coming-soon-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 80px;
    height: 80px;
    margin: 0 auto var(--spacing-6);
    background: var(--color-accent-light);
    border-radius: 50%;
  }

  .coming-soon-icon svg {
    width: 40px;
    height: 40px;
    color: var(--color-accent);
  }

  .coming-soon-title {
    font-family: var(--font-script);
    font-size: var(--font-size-3xl);
    color: var(--color-accent);
    margin-bottom: var(--spacing-4);
  }

  .coming-soon-text {
    font-size: var(--font-size-lg);
    color: var(--color-text-light);
    line-height: var(--line-height-relaxed);
    margin-bottom: 0;
  }
  /* End Coming Soon Overlay styles */

  .page-hero {
    position: relative;
    overflow: hidden;
    padding: var(--spacing-24) var(--spacing-6) var(--spacing-16);
    background: linear-gradient(135deg, var(--color-accent-light) 0%, var(--color-accent) 100%);
  }

  .page-title {
    font-family: var(--font-script);
    font-size: var(--font-size-4xl);
    color: var(--color-text-inverse);
    margin-bottom: 0;
  }

  .page-hero .section-subtitle {
    color: var(--color-white-alpha-90);
  }

  .auction-section {
    background-color: var(--color-background);
  }

  .auction-intro {
    margin-bottom: var(--spacing-12);
  }

  .auction-intro-text {
    font-size: var(--font-size-lg);
    color: var(--color-text-light);
    line-height: var(--line-height-relaxed);
    max-width: 600px;
    margin: 0 auto var(--spacing-4);
  }

  .auction-update-note {
    display: inline-flex;
    align-items: center;
    gap: var(--spacing-2);
    font-size: var(--font-size-sm);
    color: var(--color-text-muted);
    margin-bottom: 0;
  }

  .auction-update-note svg {
    width: 16px;
    height: 16px;
  }

  .auction-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
    gap: var(--spacing-6);
    margin-bottom: var(--spacing-12);
  }

  .auction-card {
    background-color: var(--color-background);
    border: 2px solid var(--color-border);
    border-radius: var(--radius-xl);
    padding: var(--spacing-6);
    text-align: center;
    transition: all var(--transition-normal);
  }

  .auction-card:hover {
    border-color: var(--color-accent);
    box-shadow: var(--shadow-lg);
  }

  .auction-icon {
    font-size: var(--font-size-4xl);
    margin-bottom: var(--spacing-4);
  }

  .auction-title {
    font-family: var(--font-heading);
    font-size: var(--font-size-xl);
    color: var(--color-text);
    margin-bottom: var(--spacing-3);
  }

  .auction-description {
    font-size: var(--font-size-sm);
    color: var(--color-text-light);
    line-height: var(--line-height-relaxed);
    margin-bottom: var(--spacing-6);
  }

  .auction-status {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--spacing-4);
    padding: var(--spacing-4);
    background-color: var(--color-secondary);
    border-radius: var(--radius-lg);
    margin-bottom: var(--spacing-4);
  }

  .auction-current,
  .auction-leader {
    text-align: center;
  }

  .auction-label {
    display: block;
    font-size: var(--font-size-xs);
    color: var(--color-text-muted);
    text-transform: uppercase;
    letter-spacing: var(--letter-spacing-wide);
    margin-bottom: var(--spacing-1);
  }

  .auction-value {
    display: block;
    font-family: var(--font-heading);
    font-size: var(--font-size-lg);
    font-weight: var(--font-weight-semibold);
  }

  .auction-value.bid {
    color: var(--color-accent);
  }

  .auction-value.winner {
    color: var(--color-primary);
  }

  .auction-min {
    font-size: var(--font-size-sm);
    color: var(--color-text-muted);
    margin-bottom: var(--spacing-4);
  }

  .auction-bid-btn {
    width: 100%;
  }

  .auction-rules {
    max-width: 600px;
    margin: 0 auto;
    padding: var(--spacing-8);
    background-color: var(--color-background-alt);
    border-radius: var(--radius-xl);
  }

  .auction-rules-title {
    font-family: var(--font-heading);
    font-size: var(--font-size-xl);
    color: var(--color-text);
    text-align: center;
    margin-bottom: var(--spacing-6);
  }

  .auction-rules-list {
    margin: 0;
    padding-left: var(--spacing-6);
  }

  .auction-rules-list li {
    margin-bottom: var(--spacing-3);
    color: var(--color-text-light);
    line-height: var(--line-height-relaxed);
  }

  .auction-rules-list li:last-child {
    margin-bottom: 0;
  }

  @media (max-width: 768px) {
    .auction-grid {
      grid-template-columns: 1fr;
    }
  }

  /* Modal Styles */
  .bid-modal {
    position: fixed;
    inset: 0;
    z-index: 1000;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: var(--spacing-4);
    opacity: 0;
    visibility: hidden;
    transition: opacity 0.3s, visibility 0.3s;
  }

  .bid-modal.open {
    opacity: 1;
    visibility: visible;
  }

  .bid-modal-backdrop {
    position: absolute;
    inset: 0;
    background: var(--color-overlay);
  }

  .bid-modal-content {
    position: relative;
    width: 100%;
    max-width: 420px;
    background: var(--color-background);
    border-radius: var(--radius-xl);
    padding: var(--spacing-8);
    box-shadow: var(--shadow-xl);
    transform: scale(0.95);
    transition: transform 0.3s;
  }

  .bid-modal.open .bid-modal-content {
    transform: scale(1);
  }

  .bid-modal-close {
    position: absolute;
    top: var(--spacing-4);
    right: var(--spacing-4);
    width: 32px;
    height: 32px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: none;
    border: none;
    cursor: pointer;
    color: var(--color-text-muted);
    transition: color 0.2s;
  }

  .bid-modal-close:hover {
    color: var(--color-text);
  }

  .bid-modal-close svg {
    width: 20px;
    height: 20px;
  }

  .bid-modal-header {
    text-align: center;
    margin-bottom: var(--spacing-6);
  }

  .bid-modal-icon {
    display: block;
    font-size: 3rem;
    margin-bottom: var(--spacing-3);
  }

  .bid-modal-title {
    font-family: var(--font-heading);
    font-size: var(--font-size-xl);
    color: var(--color-text);
    margin: 0;
  }

  .bid-form-info {
    background: var(--color-secondary);
    border-radius: var(--radius-lg);
    padding: var(--spacing-4);
    margin-bottom: var(--spacing-6);
  }

  .bid-info-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: var(--spacing-2) 0;
  }

  .bid-info-row:first-child {
    border-bottom: 1px solid var(--color-border);
  }

  .bid-info-label {
    font-size: var(--font-size-sm);
    color: var(--color-text-muted);
  }

  .bid-info-value {
    font-family: var(--font-heading);
    font-weight: var(--font-weight-semibold);
    color: var(--color-accent);
  }

  .bid-form-group {
    margin-bottom: var(--spacing-4);
  }

  .bid-form-label {
    display: block;
    font-weight: var(--font-weight-medium);
    margin-bottom: var(--spacing-2);
    color: var(--color-text);
  }

  .bid-amount-control {
    display: flex;
    align-items: center;
    gap: var(--spacing-3);
  }

  .bid-amount-btn {
    flex-shrink: 0;
    width: 56px;
    height: 56px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: var(--color-secondary);
    border: 2px solid var(--color-border);
    border-radius: var(--radius-lg);
    cursor: pointer;
    transition: all 0.2s;
    color: var(--color-text);
  }

  .bid-amount-btn:hover:not(:disabled) {
    border-color: var(--color-accent);
    background: var(--color-accent);
    color: white;
  }

  .bid-amount-btn:active:not(:disabled) {
    transform: scale(0.95);
  }

  .bid-amount-btn:disabled {
    opacity: 0.4;
    cursor: not-allowed;
  }

  .bid-amount-btn svg {
    width: 24px;
    height: 24px;
  }

  .bid-form-input {
    flex: 1;
    min-width: 0;
    padding: var(--spacing-4);
    font-family: var(--font-body);
    font-size: var(--font-size-2xl);
    font-weight: var(--font-weight-bold);
    text-align: center;
    color: var(--color-accent);
    background: var(--color-background);
    border: 2px solid var(--color-border);
    border-radius: var(--radius-lg);
    transition: border-color 0.2s;
  }

  .bid-form-input:focus {
    outline: none;
    border-color: var(--color-accent);
  }

  .bid-form-input[readonly] {
    cursor: default;
  }

  .bid-form-hint {
    display: block;
    font-size: var(--font-size-sm);
    color: var(--color-text-muted);
    text-align: center;
    margin-top: var(--spacing-2);
  }

  .bid-message {
    margin-bottom: var(--spacing-4);
    border-radius: var(--radius-md);
    text-align: center;
    font-weight: var(--font-weight-medium);
  }

  .bid-message.success {
    padding: var(--spacing-3);
    background: var(--color-success-bg);
    border: 1px solid var(--color-success);
    color: var(--color-success-dark);
  }

  .bid-message.error {
    padding: var(--spacing-3);
    background: var(--color-error-bg);
    border: 1px solid var(--color-error);
    color: var(--color-error-dark);
  }

  .bid-form-actions {
    display: flex;
    gap: var(--spacing-3);
  }

  .bid-form-actions .btn {
    flex: 1;
  }
</style>

<script>
  import { getAuthState, getApiUrl } from '@/scripts/auth';

  interface AuctionItem {
    id: string;
    name: string;
    minBid: number;
    increment: number;
    icon: string;
  }

  interface AuctionData {
    item: string;
    bidder: string;
    amount: number;
  }

  const API_URL = getApiUrl();
  let auctionData: AuctionData[] = [];
  let currentItem: AuctionItem | null = null;

  // Item data for icons and increments
  const itemData: Record<string, { icon: string; increment: number }> = {
    'primeira-musica': { icon: '🎵', increment: 10 },
    'brinde-noivos': { icon: '🥂', increment: 25 },
    'danca-especial': { icon: '💃', increment: 25 },
    'primeira-foto': { icon: '📸', increment: 10 },
    'karaoke': { icon: '🎤', increment: 10 },
    'cubos-acucar': { icon: '🥄', increment: 2 }
  };

  function init() {
    const { guestCode, guestName } = getAuthState();

    // Set hidden fields
    const codeInput = document.getElementById('guestCode') as HTMLInputElement;
    const nameInput = document.getElementById('guestName') as HTMLInputElement;
    if (codeInput && guestCode) codeInput.value = guestCode;
    if (nameInput && guestName) nameInput.value = guestName;

    // Initial display (show placeholder)
    document.querySelectorAll('.auction-card').forEach(card => {
      const bidEl = card.querySelector('.bid');
      const winnerEl = card.querySelector('.winner');
      if (bidEl) bidEl.textContent = 'Nenhum lance';
      if (winnerEl) winnerEl.textContent = 'Seja o primeiro!';
    });

    // Fetch real data
    fetchAuctionData();

    // Update every 30 seconds
    setInterval(fetchAuctionData, 30000);

    // Setup event listeners
    setupModalListeners();
  }

  async function fetchAuctionData() {
    try {
      const res = await fetch(`${API_URL}?action=getAuction`);
      const data = await res.json();

      if (data.success && data.auctions) {
        auctionData = data.auctions;
        updateAuctionDisplay();
      }
    } catch {
      // Silently fail
    }
  }

  function updateAuctionDisplay() {
    auctionData.forEach(auction => {
      // Match by item id (e.g., 'primeira-musica')
      const card = document.querySelector(`[data-auction="${auction.item}"]`);
      if (!card) return;

      const bidEl = card.querySelector('.bid');
      const winnerEl = card.querySelector('.winner');

      if (bidEl) {
        bidEl.textContent = auction.amount
          ? `R$ ${auction.amount.toFixed(0)}`
          : 'Nenhum lance';
      }

      if (winnerEl) {
        winnerEl.textContent = auction.bidder || 'Seja o primeiro!';
      }
    });
  }

  function setupModalListeners() {
    const modal = document.getElementById('bidModal');
    const backdrop = modal?.querySelector('.bid-modal-backdrop');
    const closeBtn = document.getElementById('closeModal');
    const cancelBtn = document.getElementById('cancelBid');
    const bidForm = document.getElementById('bidForm');
    const incrementBtn = document.getElementById('bidIncrement');
    const decrementBtn = document.getElementById('bidDecrement');

    // Open modal when clicking bid buttons
    document.querySelectorAll('.auction-bid-btn').forEach(btn => {
      btn.addEventListener('click', () => {
        const itemId = btn.getAttribute('data-item-id') || '';
        const itemName = btn.getAttribute('data-item-name') || '';
        const minBid = parseInt(btn.getAttribute('data-min-bid') || '0');
        const increment = parseInt(btn.getAttribute('data-increment') || '10');
        const data = itemData[itemId] || { icon: '🎁', increment: 10 };

        openModal({
          id: itemId,
          name: itemName,
          minBid,
          increment: increment || data.increment,
          icon: data.icon
        });
      });
    });

    // Increment/Decrement buttons
    incrementBtn?.addEventListener('click', () => {
      if (!currentItem) return;
      const bidAmountInput = document.getElementById('bidAmount') as HTMLInputElement;
      const currentValue = parseInt(bidAmountInput?.value || '0');
      const newValue = currentValue + currentItem.increment;
      bidAmountInput.value = String(newValue);
      updateDecrementButtonState();
    });

    decrementBtn?.addEventListener('click', () => {
      if (!currentItem) return;
      const bidAmountInput = document.getElementById('bidAmount') as HTMLInputElement;
      const currentValue = parseInt(bidAmountInput?.value || '0');
      const minRequired = getMinRequired();
      const newValue = currentValue - currentItem.increment;

      // Only decrement if we stay at or above minimum
      if (newValue >= minRequired) {
        bidAmountInput.value = String(newValue);
        updateDecrementButtonState();
      }
    });

    // Close modal
    closeBtn?.addEventListener('click', closeModal);
    cancelBtn?.addEventListener('click', closeModal);
    backdrop?.addEventListener('click', closeModal);

    // Close on Escape key
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') closeModal();
    });

    // Submit bid
    bidForm?.addEventListener('submit', handleBidSubmit);
  }

  function getMinRequired(): number {
    if (!currentItem) return 0;
    const currentAuction = auctionData.find(a => a.item === currentItem?.id);
    const currentBid = currentAuction?.amount || 0;
    return currentBid > 0 ? currentBid + currentItem.increment : currentItem.minBid;
  }

  function updateDecrementButtonState() {
    const decrementBtn = document.getElementById('bidDecrement') as HTMLButtonElement;
    const bidAmountInput = document.getElementById('bidAmount') as HTMLInputElement;
    if (!decrementBtn || !bidAmountInput || !currentItem) return;

    const currentValue = parseInt(bidAmountInput.value || '0');
    const minRequired = getMinRequired();

    // Disable if decrementing would go below minimum
    decrementBtn.disabled = (currentValue - currentItem.increment) < minRequired;
  }

  function openModal(item: AuctionItem) {
    currentItem = item;
    const modal = document.getElementById('bidModal');
    const modalIcon = document.getElementById('modalIcon');
    const modalTitle = document.getElementById('modalTitle');
    const itemIdInput = document.getElementById('itemId') as HTMLInputElement;
    const itemNameInput = document.getElementById('itemName') as HTMLInputElement;
    const bidAmountInput = document.getElementById('bidAmount') as HTMLInputElement;
    const minBidHint = document.getElementById('minBidHint');
    const modalCurrentBid = document.getElementById('modalCurrentBid');
    const modalCurrentWinner = document.getElementById('modalCurrentWinner');
    const bidMessage = document.getElementById('bidMessage');

    // Set modal content
    if (modalIcon) modalIcon.textContent = item.icon;
    if (modalTitle) modalTitle.textContent = item.name;
    if (itemIdInput) itemIdInput.value = item.id;
    if (itemNameInput) itemNameInput.value = item.name;

    // Get current bid for this item
    const currentAuction = auctionData.find(a => a.item === item.id);
    const currentBid = currentAuction?.amount || 0;
    const currentWinner = currentAuction?.bidder || 'Nenhum';

    // Calculate minimum bid (current bid + increment, or minBid if no bids)
    const minRequired = currentBid > 0 ? currentBid + item.increment : item.minBid;

    if (modalCurrentBid) modalCurrentBid.textContent = currentBid > 0 ? `R$ ${currentBid}` : 'R$ 0';
    if (modalCurrentWinner) modalCurrentWinner.textContent = currentWinner;
    if (bidAmountInput) {
      bidAmountInput.min = String(minRequired);
      bidAmountInput.value = String(minRequired);
      bidAmountInput.step = String(item.increment);
    }
    if (minBidHint) minBidHint.textContent = `Lance mínimo: R$ ${minRequired} (incremento de R$ ${item.increment})`;
    if (bidMessage) {
      bidMessage.textContent = '';
      bidMessage.className = 'bid-message';
    }

    // Update decrement button state
    updateDecrementButtonState();

    // Open modal
    modal?.classList.add('open');
    document.body.style.overflow = 'hidden';
  }

  function closeModal() {
    const modal = document.getElementById('bidModal');
    modal?.classList.remove('open');
    document.body.style.overflow = '';
    currentItem = null;
  }

  async function handleBidSubmit(e: Event) {
    e.preventDefault();

    const { guestCode, guestName } = getAuthState();
    const itemIdInput = document.getElementById('itemId') as HTMLInputElement;
    const bidAmountInput = document.getElementById('bidAmount') as HTMLInputElement;
    const submitBtn = document.getElementById('submitBid') as HTMLButtonElement;
    const bidMessage = document.getElementById('bidMessage');

    const itemId = itemIdInput?.value;
    const bidAmount = parseInt(bidAmountInput?.value || '0');

    if (!guestCode || !guestName) {
      if (bidMessage) {
        bidMessage.textContent = 'Erro de autenticação. Faça login novamente.';
        bidMessage.className = 'bid-message error';
      }
      return;
    }

    if (!bidAmount || bidAmount < 1) {
      if (bidMessage) {
        bidMessage.textContent = 'Digite um valor válido para o lance.';
        bidMessage.className = 'bid-message error';
      }
      return;
    }

    // Validate minimum bid
    const currentAuction = auctionData.find(a => a.item === itemId);
    const currentBid = currentAuction?.amount || 0;
    const increment = currentItem?.increment || 10;
    const minRequired = currentBid > 0 ? currentBid + increment : (currentItem?.minBid || 0);

    if (bidAmount < minRequired) {
      if (bidMessage) {
        bidMessage.textContent = `O lance deve ser de pelo menos R$ ${minRequired}.`;
        bidMessage.className = 'bid-message error';
      }
      return;
    }

    // Disable button
    if (submitBtn) {
      submitBtn.disabled = true;
      submitBtn.textContent = 'Enviando...';
    }

    try {
      const res = await fetch(API_URL, {
        method: 'POST',
        headers: { 'Content-Type': 'text/plain' },
        body: JSON.stringify({
          action: 'submitBid',
          guestCode,
          guestName,
          item: itemId,
          amount: bidAmount
        })
      });

      const result = await res.json();

      if (result.success) {
        if (bidMessage) {
          bidMessage.textContent = 'Lance enviado com sucesso!';
          bidMessage.className = 'bid-message success';
        }

        // Update local data
        const existingIndex = auctionData.findIndex(a => a.item === itemId);
        if (existingIndex >= 0) {
          auctionData[existingIndex] = { item: itemId, bidder: guestName || '', amount: bidAmount };
        } else {
          auctionData.push({ item: itemId, bidder: guestName || '', amount: bidAmount });
        }
        updateAuctionDisplay();

        // Close modal after delay
        setTimeout(closeModal, 1500);
      } else {
        if (bidMessage) {
          bidMessage.textContent = result.error || 'Erro ao enviar lance. Tente novamente.';
          bidMessage.className = 'bid-message error';
        }
      }
    } catch {
      if (bidMessage) {
        bidMessage.textContent = 'Erro de conexão. Tente novamente.';
        bidMessage.className = 'bid-message error';
      }
    } finally {
      if (submitBtn) {
        submitBtn.disabled = false;
        submitBtn.textContent = 'Confirmar Lance';
      }
    }
  }

  document.addEventListener('DOMContentLoaded', init);
  document.addEventListener('astro:page-load', init);
</script>
