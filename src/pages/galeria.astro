---
import ProtectedLayout from '@/layouts/ProtectedLayout.astro';
import HeroDecoration from '@/components/HeroDecoration.astro';
---

<ProtectedLayout title="Galeria">
  <section class="page-hero">
    <HeroDecoration variant="light" />
    <div class="container text-center">
      <p class="section-subtitle">Momentos</p>
      <h1 class="page-title">Galeria de Fotos</h1>
    </div>
  </section>

  <section class="section gallery-section">
    <div class="container">
      <div class="gallery-loading" id="galleryLoading">
        <div class="gallery-spinner"></div>
        <p>Carregando fotos...</p>
      </div>

      <div class="gallery-grid" id="galleryGrid"></div>

      <p class="gallery-empty" id="galleryEmpty">
        As fotos serão adicionadas em breve. Fique ligado!
      </p>
    </div>
  </section>

  <section class="section upload-section">
    <div class="container container-narrow">
      <div class="upload-card">
        <h2 class="upload-title">Compartilhe suas fotos</h2>
        <p class="upload-text">
          Tem fotos com o casal ou do evento? Envie para nós!
          As melhores serão adicionadas à galeria.
        </p>

        <div class="upload-area" id="uploadArea">
          <input type="file" id="photoInput" accept="image/*" multiple hidden />
          <div class="upload-content" id="uploadContent">
            <svg class="upload-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
              <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
              <polyline points="17,8 12,3 7,8"></polyline>
              <line x1="12" y1="3" x2="12" y2="15"></line>
            </svg>
            <span>Clique ou arraste fotos aqui</span>
            <small>JPG, PNG (qualidade original mantida)</small>
          </div>
          <div class="upload-preview" id="uploadPreview"></div>
        </div>

        <button class="btn btn-primary btn-lg upload-btn" id="uploadBtn">
          <span class="btn-text">Enviar fotos</span>
          <span class="btn-loading">
            <svg class="btn-spinner" viewBox="0 0 24 24">
              <circle cx="12" cy="12" r="10" stroke="currentColor" stroke-width="3" fill="none" stroke-dasharray="30 70"></circle>
            </svg>
            Enviando...
          </span>
        </button>

        <div class="upload-message" id="uploadMessage"></div>
      </div>
    </div>
  </section>

  <div class="lightbox" id="lightbox">
    <button class="lightbox-close" id="lightboxClose" aria-label="Fechar">&times;</button>
    <button class="lightbox-prev" id="lightboxPrev" aria-label="Anterior">&#8249;</button>
    <button class="lightbox-next" id="lightboxNext" aria-label="Próximo">&#8250;</button>
    <div class="lightbox-body">
      <div class="lightbox-spinner" id="lightboxSpinner"></div>
      <img id="lightboxImage" src="" alt="" />
    </div>
  </div>
</ProtectedLayout>

<style is:global>
  /* Page Hero */
  .page-hero {
    position: relative;
    overflow: hidden;
    padding: var(--spacing-24) var(--spacing-6) var(--spacing-16);
    background: linear-gradient(135deg, var(--color-secondary-light) 0%, var(--color-secondary) 100%);
  }

  .page-title {
    font-family: var(--font-script);
    font-size: var(--font-size-4xl);
    color: var(--color-primary);
    margin-bottom: 0;
  }

  /* Gallery Section */
  .gallery-section {
    background-color: var(--color-background);
  }

  .gallery-loading {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--spacing-4);
    padding: var(--spacing-12);
    color: var(--color-text-light);
  }

  .gallery-spinner {
    width: 40px;
    height: 40px;
    border: 3px solid var(--color-border);
    border-top-color: var(--color-primary);
    border-radius: 50%;
    animation: gallerySpin 1s linear infinite;
  }

  @keyframes gallerySpin {
    to { transform: rotate(360deg); }
  }

  .gallery-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: var(--spacing-4);
    margin-bottom: var(--spacing-8);
  }

  .gallery-empty {
    display: none;
    text-align: center;
    font-size: var(--font-size-md);
    color: var(--color-text-light);
    font-style: italic;
    padding: var(--spacing-8);
  }

  /* Gallery Item - dynamically created */
  .gallery-item {
    position: relative;
    aspect-ratio: 4 / 3;
    border-radius: var(--radius-lg);
    overflow: hidden;
    cursor: pointer;
    background-color: var(--color-secondary);
  }

  .gallery-item img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.3s ease;
  }

  .gallery-item:hover img {
    transform: scale(1.05);
  }

  .gallery-item .overlay {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background-color: var(--color-overlay);
    display: flex;
    align-items: center;
    justify-content: center;
    opacity: 0;
    transition: opacity 0.3s ease;
  }

  .gallery-item:hover .overlay {
    opacity: 1;
  }

  .gallery-item .overlay-icon {
    width: 32px;
    height: 32px;
    color: var(--color-white);
    stroke-width: 2;
  }

  /* Upload Section */
  .upload-section {
    background-color: var(--color-background-alt);
  }

  .upload-card {
    background-color: var(--color-background);
    border-radius: var(--radius-xl);
    padding: var(--spacing-8);
    text-align: center;
    box-shadow: var(--shadow-md);
  }

  .upload-title {
    font-family: var(--font-heading);
    font-size: var(--font-size-2xl);
    color: var(--color-text);
    margin-bottom: var(--spacing-2);
  }

  .upload-text {
    color: var(--color-text-light);
    margin-bottom: var(--spacing-6);
  }

  .upload-area {
    border: 2px dashed var(--color-border);
    border-radius: var(--radius-lg);
    padding: var(--spacing-8);
    margin-bottom: var(--spacing-4);
    cursor: pointer;
    transition: all 0.2s ease;
  }

  .upload-area:hover,
  .upload-area.dragover {
    border-color: var(--color-primary);
    background-color: var(--color-secondary);
  }

  .upload-content {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--spacing-2);
    color: var(--color-text-light);
  }

  .upload-icon {
    width: 48px;
    height: 48px;
    color: var(--color-primary);
  }

  .upload-content small {
    font-size: var(--font-size-sm);
    color: var(--color-text-muted);
  }

  .upload-preview {
    display: none;
    flex-wrap: wrap;
    gap: var(--spacing-2);
    justify-content: center;
  }

  .preview-item {
    position: relative;
    width: 100px;
    height: 100px;
    border-radius: var(--radius-md);
    overflow: hidden;
  }

  .preview-item img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .preview-remove {
    position: absolute;
    top: 4px;
    right: 4px;
    width: 24px;
    height: 24px;
    background-color: var(--color-black-alpha-70);
    color: var(--color-white);
    border: none;
    border-radius: 50%;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 16px;
    line-height: 1;
  }

  .upload-btn {
    display: none;
  }

  .upload-btn .btn-text {
    display: flex;
    align-items: center;
    gap: var(--spacing-2);
  }

  .upload-btn .btn-loading {
    display: none;
    align-items: center;
    gap: var(--spacing-2);
  }

  .upload-btn.loading .btn-text {
    display: none;
  }

  .upload-btn.loading .btn-loading {
    display: flex;
  }

  .btn-spinner {
    width: 20px;
    height: 20px;
    animation: gallerySpin 1s linear infinite;
  }

  .upload-message {
    margin-top: var(--spacing-4);
    padding: var(--spacing-3) var(--spacing-4);
    border-radius: var(--radius-md);
    font-size: var(--font-size-sm);
    display: none;
  }

  .upload-message.success {
    display: block;
    background-color: var(--color-success-bg-light);
    color: var(--color-success-dark);
  }

  .upload-message.error {
    display: block;
    background-color: var(--color-error-bg-light);
    color: var(--color-error-dark);
  }

  /* Lightbox */
  .lightbox {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    z-index: 9999;
    background-color: var(--color-overlay-dark);
    display: none;
    align-items: center;
    justify-content: center;
  }

  .lightbox.active {
    display: flex;
  }

  .lightbox-close {
    position: absolute;
    top: 20px;
    right: 20px;
    width: 48px;
    height: 48px;
    background: none;
    border: none;
    color: var(--color-white);
    font-size: 40px;
    cursor: pointer;
    opacity: 0.8;
    transition: opacity 0.2s;
    line-height: 1;
  }

  .lightbox-close:hover {
    opacity: 1;
  }

  .lightbox-prev,
  .lightbox-next {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    width: 60px;
    height: 60px;
    background: var(--color-white-alpha-10);
    border: none;
    border-radius: 50%;
    color: var(--color-white);
    font-size: 36px;
    cursor: pointer;
    opacity: 0.8;
    transition: opacity 0.2s, background 0.2s;
    display: flex;
    align-items: center;
    justify-content: center;
    line-height: 1;
  }

  .lightbox-prev:hover,
  .lightbox-next:hover {
    opacity: 1;
    background: var(--color-white-alpha-20);
  }

  .lightbox-prev {
    left: 20px;
  }

  .lightbox-next {
    right: 20px;
  }

  .lightbox-body {
    display: flex;
    align-items: center;
    justify-content: center;
    max-width: 90vw;
    max-height: 90vh;
  }

  .lightbox-body img {
    max-width: 90vw;
    max-height: 90vh;
    object-fit: contain;
    border-radius: 4px;
    opacity: 0;
    transition: opacity 0.3s ease;
  }

  .lightbox-body img.loaded {
    opacity: 1;
  }

  .lightbox-spinner {
    position: absolute;
    width: 50px;
    height: 50px;
    border: 4px solid var(--color-white-alpha-30);
    border-top-color: var(--color-white);
    border-radius: 50%;
    animation: gallerySpin 1s linear infinite;
  }

  .lightbox-spinner.hidden {
    display: none;
  }

  @media (max-width: 768px) {
    .gallery-grid {
      grid-template-columns: repeat(2, 1fr);
      gap: var(--spacing-2);
    }

    .lightbox-prev,
    .lightbox-next {
      width: 44px;
      height: 44px;
      font-size: 28px;
    }

    .lightbox-prev {
      left: 10px;
    }

    .lightbox-next {
      right: 10px;
    }

    .upload-card {
      padding: var(--spacing-6);
    }
  }
</style>

<script>
  import { getApiUrl, getGuestCode, getGuestName } from '@/scripts/auth';

  interface GalleryImage {
    id: string;
    name: string;
    url: string;
    thumbnail: string;
  }

  let images: GalleryImage[] = [];
  let currentIndex = 0;
  let selectedFiles: File[] = [];

  // Gallery
  async function loadGallery() {
    const loading = document.getElementById('galleryLoading');
    const grid = document.getElementById('galleryGrid');
    const empty = document.getElementById('galleryEmpty');

    try {
      const response = await fetch(`${getApiUrl()}?action=getGallery`);
      const data = await response.json();

      if (loading) loading.style.display = 'none';

      if (data.success && data.images && data.images.length > 0) {
        images = data.images;
        renderGallery();
      } else {
        if (empty) empty.style.display = 'block';
      }
    } catch (error) {
      console.error('Error loading gallery:', error);
      if (loading) loading.innerHTML = '<p>Erro ao carregar fotos</p>';
    }
  }

  function renderGallery() {
    const grid = document.getElementById('galleryGrid');
    if (!grid) return;

    grid.innerHTML = images.map((img, index) => `
      <div class="gallery-item" data-index="${index}">
        <img src="${img.thumbnail}" alt="${img.name}" />
        <div class="overlay">
          <svg class="overlay-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor">
            <circle cx="11" cy="11" r="8"></circle>
            <path d="M21 21l-4.35-4.35"></path>
          </svg>
        </div>
      </div>
    `).join('');

    grid.querySelectorAll('.gallery-item').forEach((item) => {
      item.addEventListener('click', () => {
        const index = parseInt(item.getAttribute('data-index') || '0');
        openLightbox(index);
      });
    });
  }

  // Lightbox
  function openLightbox(index: number) {
    currentIndex = index;
    const lightbox = document.getElementById('lightbox');

    if (lightbox) {
      lightbox.classList.add('active');
      document.body.style.overflow = 'hidden';
      loadLightboxImage(index);
    }
  }

  function closeLightbox() {
    const lightbox = document.getElementById('lightbox');
    const img = document.getElementById('lightboxImage') as HTMLImageElement;

    if (lightbox) {
      lightbox.classList.remove('active');
      document.body.style.overflow = '';
    }

    if (img) {
      img.classList.remove('loaded');
      img.src = '';
    }
  }

  function loadLightboxImage(index: number) {
    const img = document.getElementById('lightboxImage') as HTMLImageElement;
    const spinner = document.getElementById('lightboxSpinner');

    if (!img || !images[index]) return;

    // Reset state
    img.classList.remove('loaded');
    if (spinner) spinner.classList.remove('hidden');

    // Set up load handlers on the actual image element
    img.onload = () => {
      img.classList.add('loaded');
      if (spinner) spinner.classList.add('hidden');
    };
    img.onerror = () => {
      // Show anyway even if error
      img.classList.add('loaded');
      if (spinner) spinner.classList.add('hidden');
    };

    // Set the source - use thumbnail with larger size (avoids forbidden on direct URL)
    img.alt = images[index].name;
    img.src = images[index].thumbnail.replace('sz=w400', 'sz=w1600');
  }

  function showPrev() {
    if (images.length === 0) return;
    currentIndex = (currentIndex - 1 + images.length) % images.length;
    loadLightboxImage(currentIndex);
  }

  function showNext() {
    if (images.length === 0) return;
    currentIndex = (currentIndex + 1) % images.length;
    loadLightboxImage(currentIndex);
  }

  // Upload
  function initUpload() {
    const uploadArea = document.getElementById('uploadArea');
    const photoInput = document.getElementById('photoInput') as HTMLInputElement;
    const uploadBtn = document.getElementById('uploadBtn');

    if (!uploadArea || !photoInput) return;

    uploadArea.addEventListener('click', (e) => {
      if ((e.target as HTMLElement).closest('.preview-remove')) return;
      photoInput.click();
    });

    uploadArea.addEventListener('dragover', (e) => {
      e.preventDefault();
      uploadArea.classList.add('dragover');
    });

    uploadArea.addEventListener('dragleave', () => {
      uploadArea.classList.remove('dragover');
    });

    uploadArea.addEventListener('drop', (e) => {
      e.preventDefault();
      uploadArea.classList.remove('dragover');
      const files = (e as DragEvent).dataTransfer?.files;
      if (files) handleFiles(Array.from(files));
    });

    photoInput.addEventListener('change', () => {
      if (photoInput.files) handleFiles(Array.from(photoInput.files));
    });

    uploadBtn?.addEventListener('click', uploadPhotos);
  }

  function handleFiles(files: File[]) {
    const imageFiles = files.filter(f => f.type.startsWith('image/'));
    selectedFiles = [...selectedFiles, ...imageFiles];
    renderPreview();
  }

  function renderPreview() {
    const uploadContent = document.getElementById('uploadContent');
    const uploadPreview = document.getElementById('uploadPreview');
    const uploadBtn = document.getElementById('uploadBtn');

    if (!uploadPreview) return;

    if (selectedFiles.length === 0) {
      if (uploadContent) uploadContent.style.display = 'flex';
      uploadPreview.style.display = 'none';
      if (uploadBtn) uploadBtn.style.display = 'none';
      return;
    }

    if (uploadContent) uploadContent.style.display = 'none';
    uploadPreview.style.display = 'flex';
    if (uploadBtn) uploadBtn.style.display = 'inline-flex';

    uploadPreview.innerHTML = selectedFiles.map((file, index) => {
      const url = URL.createObjectURL(file);
      return `
        <div class="preview-item">
          <img src="${url}" alt="${file.name}" />
          <button class="preview-remove" data-index="${index}">&times;</button>
        </div>
      `;
    }).join('');

    uploadPreview.querySelectorAll('.preview-remove').forEach((btn) => {
      btn.addEventListener('click', (e) => {
        e.stopPropagation();
        const index = parseInt(btn.getAttribute('data-index') || '0');
        selectedFiles.splice(index, 1);
        renderPreview();
      });
    });
  }

  async function uploadPhotos() {
    if (selectedFiles.length === 0) return;

    const uploadBtn = document.getElementById('uploadBtn');
    const uploadMessage = document.getElementById('uploadMessage');

    if (uploadBtn) {
      uploadBtn.classList.add('loading');
      (uploadBtn as HTMLButtonElement).disabled = true;
    }
    if (uploadMessage) uploadMessage.className = 'upload-message';

    const guestCode = getGuestCode() || '';
    const guestName = getGuestName() || '';
    let successCount = 0;

    for (const file of selectedFiles) {
      try {
        const base64 = await readFileAsBase64(file);
        const timestamp = new Date().toISOString().replace(/[:.]/g, '-');
        const ext = file.name.split('.').pop();
        const fileName = `${guestCode}-${timestamp}.${ext}`;

        const payload = {
          action: 'uploadPhoto',
          guestCode,
          guestName,
          photoBase64: base64,
          photoName: fileName,
          photoType: file.type
        };

        const response = await fetch(getApiUrl(), {
          method: 'POST',
          headers: { 'Content-Type': 'text/plain' },
          body: JSON.stringify(payload),
          redirect: 'follow'
        });

        const result = await response.json();
        if (result.success) successCount++;
      } catch (error) {
        console.error('Error uploading photo:', error);
      }
    }

    if (uploadBtn) {
      uploadBtn.classList.remove('loading');
      (uploadBtn as HTMLButtonElement).disabled = false;
    }

    if (uploadMessage) {
      if (successCount === selectedFiles.length) {
        uploadMessage.className = 'upload-message success';
        uploadMessage.textContent = `${successCount} foto(s) enviada(s) com sucesso! Obrigado!`;
        selectedFiles = [];
        renderPreview();
      } else {
        uploadMessage.className = 'upload-message error';
        uploadMessage.textContent = `${successCount}/${selectedFiles.length} fotos enviadas. Tente novamente.`;
      }
    }
  }

  function readFileAsBase64(file: File): Promise<string> {
    return new Promise((resolve, reject) => {
      const reader = new FileReader();
      reader.onload = () => {
        const result = reader.result as string;
        resolve(result.split(',')[1]);
      };
      reader.onerror = () => reject(new Error('Failed to read file'));
      reader.readAsDataURL(file);
    });
  }

  // Init
  function init() {
    loadGallery();
    initUpload();

    const lightbox = document.getElementById('lightbox');
    const closeBtn = document.getElementById('lightboxClose');
    const prevBtn = document.getElementById('lightboxPrev');
    const nextBtn = document.getElementById('lightboxNext');

    closeBtn?.addEventListener('click', closeLightbox);
    prevBtn?.addEventListener('click', showPrev);
    nextBtn?.addEventListener('click', showNext);

    lightbox?.addEventListener('click', (e) => {
      if (e.target === lightbox) closeLightbox();
    });

    document.addEventListener('keydown', (e) => {
      if (!lightbox?.classList.contains('active')) return;
      if (e.key === 'Escape') closeLightbox();
      if (e.key === 'ArrowLeft') showPrev();
      if (e.key === 'ArrowRight') showNext();
    });
  }

  document.addEventListener('DOMContentLoaded', init);
  document.addEventListener('astro:page-load', init);
</script>
